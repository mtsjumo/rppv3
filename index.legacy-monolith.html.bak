<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI RPP Generator - Kurikulum Merdeka + KBC</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📋</text></svg>">
<script src="https://cdn.jsdelivr.net/npm/docx@8.5.0/build/index.umd.js"></script>
<style>
:root {
  --pink: #e91e63;
  --pink-dark: #c2185b;
  --pink-light: #fce4ec;
  --blue: #1976d2;
  --blue-light: #e3f2fd;
  --blue-dark: #1565c0;
  --green: #43a047;
  --green-light: #e8f5e9;
  --orange: #ef6c00;
  --orange-light: #fff3e0;
  --text: #212121;
  --text-secondary: #616161;
  --border: #bdbdbd;
  --bg: #f5f5f5;
  --white: #ffffff;
  --shadow: 0 2px 8px rgba(0,0,0,0.12);
  --radius: 8px;
  --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}
.hidden { display: none !important; }

/* ===== HEADER ===== */
.app-header {
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: var(--white);
  padding: 16px 20px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow);
}
.app-header h1 {
  font-size: 1.25rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
}
.app-header h1 span { font-size: 0.875rem; font-weight: 400; opacity: 0.85; }
.app-header .header-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: none;
  border-radius: var(--radius);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-family: var(--font);
}
.btn:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.btn-pink { background: var(--pink); color: var(--white); }
.btn-pink:hover { background: var(--pink-dark); }
.btn-blue { background: var(--blue); color: var(--white); }
.btn-blue:hover { background: var(--blue-dark); }
.btn-green { background: var(--green); color: var(--white); }
.btn-green:hover { background: #2e7d32; }
.btn-orange { background: var(--orange); color: var(--white); }
.btn-outline { background: transparent; color: var(--text); border: 1px solid var(--border); }
.btn-outline:hover { background: var(--bg); }
.btn-sm { padding: 4px 10px; font-size: 0.75rem; }
.btn-lg { padding: 12px 24px; font-size: 1rem; }
.btn-icon { padding: 6px 10px; }

/* ===== MAIN ===== */
.main-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 16px;
}
.card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20px;
  margin-bottom: 16px;
}
.card-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--pink);
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--pink-light);
}

/* ===== SETTINGS PANEL ===== */
.settings-panel {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 16px;
  overflow: hidden;
}
.settings-toggle {
  width: 100%;
  padding: 12px 16px;
  background: var(--pink-light);
  border: none;
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--pink);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font);
}
.settings-toggle:hover { background: #f8bbd0; }
.settings-body {
  padding: 16px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
@media (max-width: 640px) {
  .settings-body { grid-template-columns: 1fr; }
}
.form-group { display: flex; flex-direction: column; gap: 4px; }
.form-group label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
}
.form-input, .form-select, .form-textarea {
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 4px;
  font-size: 0.875rem;
  font-family: var(--font);
  outline: none;
  transition: border 0.2s;
}
.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--pink);
  box-shadow: 0 0 0 2px var(--pink-light);
}
.form-textarea { min-height: 80px; resize: vertical; }
.form-hint { font-size: 0.75rem; color: var(--text-secondary); font-style: italic; }
.form-full { grid-column: 1 / -1; }

/* ===== WIZARD ===== */
.wizard-progress {
  display: flex;
  gap: 4px;
  margin-bottom: 16px;
  padding: 0;
  list-style: none;
}
.wizard-step {
  flex: 1;
  text-align: center;
  padding: 10px 8px;
  border-radius: var(--radius);
  font-size: 0.8rem;
  font-weight: 600;
  background: var(--bg);
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s;
}
.wizard-step.active { background: var(--pink); color: var(--white); }
.wizard-step.done { background: var(--green-light); color: var(--green); }
.wizard-step .step-num {
  display: inline-block;
  width: 24px; height: 24px;
  line-height: 24px;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.1);
  font-size: 0.75rem;
  margin-right: 6px;
}
.wizard-step.active .step-num { background: rgba(255,255,255,0.3); }
.wizard-step.done .step-num { background: var(--green); color: var(--white); }
@media (max-width: 640px) {
  .wizard-step .step-label { display: none; }
  .wizard-step .step-num { margin-right: 0; }
}

/* ===== FORM STEP 0 ===== */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.form-grid-3 { grid-template-columns: 1fr 1fr 1fr; }
.form-full { grid-column: 1 / -1; }
.form-section {
  border: 1px solid var(--pink-light);
  border-radius: var(--radius);
  padding: 12px;
  margin-bottom: 12px;
}
.form-section-title {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--pink);
  margin-bottom: 8px;
}
@media (max-width: 640px) {
  .form-grid { grid-template-columns: 1fr; }
  .form-grid-3 { grid-template-columns: 1fr; }
}

/* ===== PHASE CONTENT ===== */
.phase-section {
  margin-bottom: 20px;
}
.phase-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin: 12px 0;
}
.phase-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}
.phase-status.pending { background: var(--bg); color: var(--text-secondary); }
.phase-status.success { background: var(--green-light); color: var(--green); }
.phase-status.error { background: #ffebee; color: #c62828; }
.phase-status.loading { background: #fff8e1; color: #f57f17; }

/* ===== PREVIEW TABS ===== */
.preview-tabs {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  margin-bottom: 8px;
  border-bottom: 2px solid var(--pink-light);
  padding-bottom: 0;
}
.preview-tab {
  padding: 8px 14px;
  font-size: 0.8rem;
  font-weight: 600;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-secondary);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  font-family: var(--font);
  transition: all 0.2s;
}
.preview-tab:hover { color: var(--pink); }
.preview-tab.active { color: var(--pink); border-bottom-color: var(--pink); }
.preview-content { min-height: 200px; padding: 4px 0; }
.preview-empty {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-secondary);
}
.preview-empty .icon { font-size: 2rem; margin-bottom: 8px; }

/* ===== EXPORT BAR ===== */
.export-bar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 16px;
  padding: 16px;
  background: var(--bg);
  border-radius: var(--radius);
}
.export-bar .label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 4px;
}

/* ===== LOADING OVERLAY ===== */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.loading-spinner {
  width: 48px; height: 48px;
  border: 4px solid var(--pink-light);
  border-top-color: var(--pink);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 12px; font-size: 0.95rem; font-weight: 600; color: var(--text); }
.loading-sub { font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px; }

/* ===== PROGRESS BAR ===== */
.progress-container {
  margin: 12px 0;
  padding: 16px;
  background: var(--white);
  border: 1px solid var(--pink-light);
  border-radius: var(--radius);
}
.progress-bar-wrap {
  width: 100%;
  height: 8px;
  background: var(--pink-light);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 8px;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 4px;
  transition: width 0.5s ease;
  width: 0%;
}
.progress-text {
  font-size: 0.8rem;
  color: var(--text-secondary);
  display: flex;
  justify-content: space-between;
}
.progress-steps {
  margin-top: 8px;
  font-size: 0.8rem;
}
.progress-step-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 3px 0;
  color: var(--text-secondary);
}
.progress-step-item.done { color: var(--green); }
.progress-step-item.active { color: var(--pink); font-weight: 600; }
.progress-step-item.pending { color: var(--text-secondary); opacity: 0.5; }
.progress-step-item .p-icon { font-size: 0.75rem; width: 16px; text-align: center; }

/* ===== TOAST ===== */
.toast-container {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.toast {
  padding: 12px 20px;
  border-radius: var(--radius);
  font-size: 0.875rem;
  font-weight: 600;
  box-shadow: var(--shadow);
  animation: slideIn 0.3s ease;
  max-width: 400px;
}
.toast.success { background: var(--green-light); color: var(--green); border-left: 4px solid var(--green); }
.toast.error { background: #ffebee; color: #c62828; border-left: 4px solid #c62828; }
.toast.warning { background: #fff8e1; color: #f57f17; border-left: 4px solid #f57f17; }
.toast.info { background: var(--blue-light); color: var(--blue); border-left: 4px solid var(--blue); }
@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* ===== RPP TEMPLATE STYLES (for preview) ===== */
.rpp-document {
  font-family: 'Times New Roman', Times, serif;
  line-height: 1.6;
  padding: 20px;
  background: var(--white);
}
.rpp-document .doc-title {
  text-align: center;
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 8px;
  text-transform: uppercase;
  color: #000;
}
.rpp-document .doc-subtitle {
  text-align: center;
  font-weight: 600;
  font-size: 1rem;
  margin-bottom: 16px;
}
.rpp-document .section-header {
  background: #e91e63;
  color: #fff;
  padding: 6px 10px;
  font-weight: 700;
  font-size: 0.95rem;
  margin: 16px 0 8px 0;
  text-transform: uppercase;
}
.rpp-document .sub-header {
  background: #e3f2fd;
  color: #1976d2;
  padding: 5px 8px;
  font-weight: 600;
  font-size: 0.9rem;
  margin: 12px 0 6px 0;
}
.rpp-document table {
  width: 100%;
  border-collapse: collapse;
  margin: 8px 0;
  font-size: 0.85rem;
}
.rpp-document th {
  background: #fce4ec;
  color: #e91e63;
  padding: 6px 8px;
  border: 1px solid #bdbdbd;
  font-weight: 700;
  text-align: left;
}
.rpp-document td {
  padding: 6px 8px;
  border: 1px solid #bdbdbd;
  vertical-align: top;
}
.rpp-document tr:nth-child(even) td { background: #fafafa; }
.rpp-document ol {
  padding-left: 24px;
  margin: 6px 0;
}
.rpp-document ul {
  padding-left: 24px;
  margin: 6px 0;
}
.rpp-document ol ol { list-style-type: lower-alpha; }
.rpp-document ol ol ol { list-style-type: lower-roman; }
.rpp-document .ident-item {
  display: flex;
  gap: 8px;
  margin: 4px 0;
}
.rpp-document .ident-label {
  font-weight: 600;
  min-width: 160px;
}
.rpp-document .pengesahan {
  margin-top: 32px;
  text-align: center;
}
.rpp-document .pengesahan-table {
  width: 100%;
  margin-top: 20px;
}
.rpp-document .pengesahan-table td {
  width: 50%;
  text-align: center;
  vertical-align: bottom;
  height: 80px;
  border: none;
  font-size: 0.85rem;
}
.rpp-document .pengesahan-table td .nama {
  font-weight: 700;
}
.rpp-document .pengesahan-table td .nuptk {
  font-size: 0.8rem;
  color: #555;
}
.rpp-document .pengesahan-table td .jabatan {
  font-size: 0.8rem;
  margin-bottom: 4px;
}
.rpp-document .pengesahan-place {
  margin-top: 16px;
  font-style: italic;
}
.rpp-document .soal-nomor {
  display: flex;
  gap: 6px;
  margin: 6px 0;
}
.rpp-document .soal-opsi {
  padding-left: 28px;
  margin: 2px 0;
}
.rpp-document .kunci-jawaban {
  font-weight: 600;
  color: #c62828;
}
.rpp-document .rubrik-table th:first-child,
.rpp-document .rubrik-table td:first-child { min-width: 180px; }

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .app-header h1 { font-size: 1rem; }
  .app-header h1 span { display: none; }
  .main-container { padding: 8px; }
  .card { padding: 12px; margin-bottom: 12px; }
  .rpp-document { padding: 10px; font-size: 0.8rem; }
  .rpp-document table { font-size: 0.75rem; }
  .rpp-document th, .rpp-document td { padding: 4px 6px; }
  .rpp-document .section-header { font-size: 0.85rem; padding: 5px 8px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-grid-3 { grid-template-columns: 1fr; }
  .settings-body { grid-template-columns: 1fr; }
  .btn-lg { padding: 10px 16px; font-size: 0.875rem; width: 100%; }
  .phase-actions { flex-direction: column; }
  .phase-actions .btn { width: 100%; justify-content: center; }
  .export-bar .btn { flex: 1; justify-content: center; }
  .header-actions { width: 100%; }
  .header-actions .btn { flex: 1; justify-content: center; }
}
@media (max-width: 480px) {
  .app-header { padding: 10px 12px; }
  .app-header h1 { font-size: 0.9rem; }
  .card-title { font-size: 0.95rem; }
  .wizard-step { font-size: 0.7rem; padding: 6px 4px; }
  .rpp-document { padding: 6px; font-size: 0.75rem; }
  .rpp-document .doc-title { font-size: 0.9rem; }
  .rpp-document table { font-size: 0.7rem; }
  .toast { max-width: 90vw; font-size: 0.8rem; padding: 8px 14px; }
}
@media print {
  @page { margin: 15mm 20mm; size: A4; }
  body * { visibility: hidden; }
  .print-area, .print-area * { visibility: visible; }
  .print-area { position: absolute; left: 0; top: 0; width: 100%; }
  .print-area .rpp-document { padding: 0; }
  .no-print { display: none !important; }
}
</style>
</head>
<body>

<!-- ===== HEADER ===== -->
<header class="app-header">
  <h1>
    AI RPP Generator
    <span>— Kurikulum Merdeka + KBC</span>
  </h1>
  <div class="header-actions">
    <button class="btn btn-outline btn-sm" onclick="toggleSettings()">⚙️ Pengaturan</button>
    <button class="btn btn-outline btn-sm" onclick="resetAll()">↺ Reset</button>
  </div>
</header>

<!-- ===== TOAST ===== -->
<div class="toast-container" id="toast-container"></div>

<!-- ===== LOADING ===== -->
<div class="loading-overlay hidden" id="loading-overlay">
  <div class="loading-spinner"></div>
  <div class="loading-text" id="loading-text">Memproses...</div>
  <div class="loading-sub" id="loading-sub">Mohon tunggu, AI sedang bekerja</div>
</div>

<!-- ===== MAIN ===== -->
<div class="main-container">

  <!-- SETTINGS -->
  <div class="settings-panel hidden" id="settings-panel">
    <button class="settings-toggle" onclick="toggleSettings()">
      ⚙️ Pengaturan API & Model
      <span id="settings-arrow">▲</span>
    </button>
    <div class="settings-body" id="settings-body">
      <div class="form-group form-full">
        <label for="set-provider">Provider AI</label>
        <select class="form-select" id="set-provider" onchange="onProviderChange()">
          <option value="openrouter">OpenRouter</option>
          <option value="poolside">Poolside (Laguna)</option>
        </select>
        <span class="form-hint" id="provider-hint">Gunakan API key OpenRouter untuk model-model gratis.</span>
      </div>
      <div class="form-group form-full grp-openrouter">
        <label for="api-key">OpenRouter API Key</label>
        <input type="password" class="form-input" id="api-key" placeholder="sk-or-v1-..." autocomplete="off">
        <span class="form-hint">Dapatkan API key gratis di <a href="https://openrouter.ai/keys" target="_blank" rel="noopener">openrouter.ai/keys</a></span>
      </div>
      <div class="form-group form-full grp-poolside" style="display:none;">
        <label for="poolside-key">Poolside API Key</label>
        <input type="password" class="form-input" id="poolside-key" placeholder="ps-..." autocomplete="off">
        <span class="form-hint">Dapatkan API key di dashboard Poolside (lihat <a href="https://docs.poolside.ai/api/overview" target="_blank" rel="noopener">docs.poolside.ai</a>). Key OpenRouter Anda tetap tersimpan terpisah.</span>
      </div>
      <div class="form-group grp-openrouter">
        <label for="model-select">Model AI</label>
        <select class="form-select" id="model-select">
          <option value="nvidia/nemotron-3-super-120b-a12b:free">Nemotron-3-Super 120B (Free)</option>
          <option value="nvidia/nemotron-3-ultra-550b-a55b:free">Nemotron-3-Ultra 550B (Free)</option>
          <option value="openrouter/free">OpenRouter Auto (Free Router)</option>
          <option value="openai/gpt-oss-120b:free">GPT-OSS 120B (Free)</option>
          <option value="google/gemma-4-31b-it:free">Gemma 4 31B (Free)</option>
          <option value="meta-llama/llama-3.3-70b-instruct:free">Llama 3.3 70B (Free)</option>
          <option value="custom">Kustom (isi sendiri)</option>
        </select>
      </div>
      <div class="form-group grp-openrouter">
        <label for="model-custom">Kustom Model ID</label>
        <input type="text" class="form-input" id="model-custom" placeholder="organization/model:free" disabled>
        <span class="form-hint">Contoh: anthropic/claude-sonnet-4-20250514:free</span>
      </div>
      <div class="form-group grp-openrouter">
        <label for="fallback-model">Fallback Model</label>
        <select class="form-select" id="fallback-model">
          <option value="openrouter/free">OpenRouter Auto (Free Router)</option>
          <option value="nvidia/nemotron-3-ultra-550b-a55b:free">Nemotron-3-Ultra 550B (Free)</option>
          <option value="nvidia/nemotron-3-super-120b-a12b:free">Nemotron-3-Super 120B (Free)</option>
          <option value="openai/gpt-oss-120b:free">GPT-OSS 120B (Free)</option>
          <option value="google/gemma-4-31b-it:free">Gemma 4 31B (Free)</option>
        </select>
      </div>
      <div class="form-group grp-poolside" style="display:none;">
        <label for="poolside-model">Poolside Model</label>
        <input type="text" class="form-input" id="poolside-model" placeholder="poolside/laguna-s-2.1">
        <span class="form-hint">Default: poolside/laguna-s-2.1 (OpenAI-compatible)</span>
      </div>
      <details class="form-full grp-poolside" id="grp-proxy-details" style="display:none;">
        <summary style="font-size:0.8rem;font-weight:600;color:var(--text-secondary);cursor:pointer;">⚙️ Pengaturan lanjutan (Worker URL)</summary>
        <div class="form-group" style="margin-top:8px;">
          <label for="poolside-proxy">Worker / Proxy URL</label>
          <input type="text" class="form-input" id="poolside-proxy" placeholder="https://nama-worker.kamu.workers.dev/?url=">
          <span class="form-hint">Sudah terisi worker bawaan — ubah hanya jika Anda memakai worker sendiri.</span>
        </div>
      </details>
      <div class="form-group" style="display:flex; flex-direction:row; align-items:flex-end; gap:8px; grid-column:1/-1;">
        <button class="btn btn-pink" onclick="saveSettings()">💾 Simpan Pengaturan</button>
        <button class="btn btn-outline" onclick="testAPI()">🧪 Test API</button>
        <span id="api-status" style="font-size:0.8rem; display:flex; align-items:center; gap:4px;"></span>
      </div>
    </div>
  </div>

  <!-- WIZARD -->
  <ul class="wizard-progress" id="wizard">
    <li class="wizard-step active" data-step="0">
      <span class="step-num">1</span>
      <span class="step-label">Identitas</span>
    </li>
    <li class="wizard-step" data-step="1">
      <span class="step-num">2</span>
      <span class="step-label">RPP + Lampiran</span>
    </li>
    <li class="wizard-step" data-step="2">
      <span class="step-num">3</span>
      <span class="step-label">Modul Ajar</span>
    </li>
    <li class="wizard-step" data-step="3">
      <span class="step-num">4</span>
      <span class="step-label">Media</span>
    </li>
  </ul>

  <!-- STEP 0: FORM -->
  <div class="card" id="step-0">
    <div class="card-title">📝 Identitas RPP</div>
    <p style="font-size:0.85rem; color:var(--text-secondary); margin-bottom:16px;">
      Isi data identitas madrasah, guru, kepala madrasah, serta Capaian Pembelajaran (CP), Tujuan Pembelajaran (TP), dan Alur Tujuan Pembelajaran (ATP).
    </p>
    <form id="rpp-form" onsubmit="return false;">
      <div class="form-section">
        <div class="form-section-title">Madrasah & Guru</div>
        <div class="form-grid">
          <div class="form-group">
            <label for="inp-madrasah">Nama Madrasah *</label>
            <input type="text" class="form-input" id="inp-madrasah" placeholder="MTs Ulfa Pranggong" required>
          </div>
          <div class="form-group">
            <label for="inp-mapel">Mata Pelajaran *</label>
            <input type="text" class="form-input" id="inp-mapel" placeholder="Ilmu Pengetahuan Alam (IPA)" required>
          </div>
          <div class="form-group">
            <label for="inp-materi">Materi Pelajaran *</label>
            <input type="text" class="form-input" id="inp-materi" placeholder="Sel Hewan dan Sel Tumbuhan" required>
          </div>
          <div class="form-group">
            <label for="inp-elemen">Elemen *</label>
            <input type="text" class="form-input" id="inp-elemen" placeholder="Pemahaman IPA" required>
          </div>
          <div class="form-group">
            <label for="inp-guru">Nama Guru *</label>
            <input type="text" class="form-input" id="inp-guru" placeholder="Siti Nafisah, S.Pd.I" required>
          </div>
          <div class="form-group">
            <label for="inp-nuptk">NUPTK Guru</label>
            <input type="text" class="form-input" id="inp-nuptk" placeholder="1234567890123456" maxlength="16">
          </div>
          <div class="form-group">
            <label for="inp-fase">Fase/Kelas/Semester *</label>
            <input type="text" class="form-input" id="inp-fase" placeholder="D/VIII/1" required>
          </div>
          <div class="form-group">
            <label for="inp-tahun-pelajaran">Tahun Ajaran *</label>
            <input type="text" class="form-input" id="inp-tahun-pelajaran" placeholder="2025/2026" required>
          </div>
          <div class="form-group">
            <label for="inp-alkok">Alokasi Waktu *</label>
            <input type="text" class="form-input" id="inp-alkok" placeholder="2 X 40 Menit" required>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">Kepala Madrasah & Pengesahan</div>
        <div class="form-grid">
          <div class="form-group">
            <label for="inp-kepsek">Nama Kepala Madrasah *</label>
            <input type="text" class="form-input" id="inp-kepsek" placeholder="Ahmad Jazuli, S.Pd" required>
          </div>
          <div class="form-group">
            <label for="inp-kepsek-nuptk">NUPTK Kepala Madrasah</label>
            <input type="text" class="form-input" id="inp-kepsek-nuptk" placeholder="1234567890123456" maxlength="16">
          </div>
          <div class="form-group">
            <label for="inp-tempat">Tempat *</label>
            <input type="text" class="form-input" id="inp-tempat" placeholder="Indramayu" required>
          </div>
          <div class="form-group">
            <label for="inp-tanggal">Tanggal Pengesahan *</label>
            <input type="date" class="form-input" id="inp-tanggal" required>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">Capain, Tujuan, dan Alur Pembelajaran</div>
        <div class="form-grid">
          <div class="form-group form-full">
            <label for="inp-cp">Capaian Pembelajaran (CP) *</label>
            <textarea class="form-textarea" id="inp-cp" placeholder="Pada akhir fase D, peserta didik mampu..." required></textarea>
          </div>
          <div class="form-group form-full">
            <label for="inp-tp">Tujuan Pembelajaran (TP) *</label>
            <textarea class="form-textarea" id="inp-tp" placeholder="1. Peserta didik mampu mendeskripsikan..." required></textarea>
          </div>
          <div class="form-group form-full">
            <label for="inp-atp">Alur Tujuan Pembelajaran (ATP)</label>
            <textarea class="form-textarea" id="inp-atp" placeholder="Rincian alur dan waktu pembelajaran..."></textarea>
          </div>
        </div>
      </div>

      <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:12px;">
        <button type="button" class="btn btn-lg btn-pink" onclick="startPhase1()">
          🚀 Generate RPP + Lampiran
        </button>
      </div>
    </form>
  </div>

  <!-- STEP 1: PHASE 1 -->
  <div class="card hidden" id="step-1">
    <div class="card-title">
      📄 RPP + Lampiran
      <span class="phase-status pending" id="phase1-status">⏳ Belum digenerate</span>
    </div>
    <div class="phase-actions">
      <button class="btn btn-pink btn-sm" onclick="startPhase1()" id="phase1-gen-btn">🚀 Generate</button>
      <button class="btn btn-outline btn-sm hidden" onclick="showStep(0)" id="phase1-back">✏️ Edit Identitas</button>
    </div>
    <div class="progress-container hidden" id="phase1-progress">
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" id="phase1-progress-fill"></div>
      </div>
      <div class="progress-text">
        <span id="phase1-progress-label">Memulai...</span>
        <span id="phase1-progress-pct">0%</span>
      </div>
      <div class="progress-steps" id="phase1-progress-steps"></div>
    </div>
    <div id="phase1-preview" class="preview-content">
      <div class="preview-empty">
        <div class="icon">📋</div>
        <p>Generate RPP + Lampiran untuk melihat hasil di sini.</p>
      </div>
    </div>
    <div class="export-bar hidden" id="phase1-regenerate" style="margin-bottom: 12px; background: #fff3cd; border-color: #ffe69c;">
      <div class="label" style="color: #664d03;">🔄 Regenerate Bagian:</div>
      <button class="btn btn-outline btn-sm" onclick="regeneratePart(0)" title="Regenerate RPP Core">1. RPP</button>
      <button class="btn btn-outline btn-sm" onclick="regeneratePart(1)" title="Regenerate LKPD">2. LKPD</button>
      <button class="btn btn-outline btn-sm" onclick="regeneratePart(2)" title="Regenerate Evaluasi">3. Evaluasi</button>
      <button class="btn btn-outline btn-sm" onclick="regeneratePart(3)" title="Regenerate Remidial, Pengayaan, Rubrik">4. Remidial/Rubrik</button>
      <button class="btn btn-outline btn-sm" onclick="regeneratePart(4)" title="Regenerate Tes Diagnostik Awal">5. Diagnostik</button>
    </div>
    <div class="export-bar hidden" id="phase1-export">
      <div class="label">💾 Export Phase 1:</div>
      <button class="btn btn-blue btn-sm" onclick="exportPhase1PDF()">📄 PDF</button>
      <button class="btn btn-green btn-sm" onclick="exportPhase1DOCX()">📝 DOCX</button>
      <button class="btn btn-orange btn-sm" onclick="exportPhase1HTML()">🌐 HTML</button>
      <button class="btn btn-pink btn-sm" onclick="showStep(2)" id="phase1-next">➡️ Lanjut Modul Ajar</button>
    </div>
  </div>

  <!-- STEP 2: PHASE 2 -->
  <div class="card hidden" id="step-2">
    <div class="card-title">
      📖 Modul Ajar
      <span class="phase-status pending" id="phase2-status">⏳ Belum digenerate</span>
    </div>
    <div class="phase-actions">
      <button class="btn btn-pink btn-sm" onclick="startPhase2()" id="phase2-gen-btn">🚀 Generate</button>
      <button class="btn btn-outline btn-sm" onclick="showStep(1)">⬅️ Kembali ke RPP</button>
    </div>
    <div id="phase2-preview" class="preview-content">
      <div class="preview-empty">
        <div class="icon">📖</div>
        <p>Generate Modul Ajar setelah RPP selesai.</p>
      </div>
    </div>
    <div class="export-bar hidden" id="phase2-export">
      <div class="label">💾 Export Phase 2:</div>
      <button class="btn btn-blue btn-sm" onclick="exportPhase2PDF()">📄 PDF</button>
      <button class="btn btn-green btn-sm" onclick="exportPhase2DOCX()">📝 DOCX</button>
      <button class="btn btn-orange btn-sm" onclick="exportPhase2HTML()">🌐 HTML</button>
      <button class="btn btn-pink btn-sm" onclick="showStep(3)" id="phase2-next">➡️ Lanjut Media</button>
    </div>
  </div>

  <!-- STEP 3: PHASE 3 -->
  <div class="card hidden" id="step-3">
    <div class="card-title">
      🎬 Media Pembelajaran
      <span class="phase-status pending" id="phase3-status">⏳ Belum digenerate</span>
    </div>
    <div class="phase-actions">
      <button class="btn btn-pink btn-sm" onclick="startPhase3()" id="phase3-gen-btn">🚀 Generate</button>
      <button class="btn btn-outline btn-sm" onclick="showStep(2)">⬅️ Kembali ke Modul Ajar</button>
    </div>
    <div id="phase3-preview" class="preview-content">
      <div class="preview-empty">
        <div class="icon">🎬</div>
        <p>Generate Media Pembelajaran setelah Modul Ajar selesai.</p>
      </div>
    </div>
    <div class="export-bar hidden" id="phase3-export">
      <div class="label">💾 Export Phase 3:</div>
      <button class="btn btn-blue btn-sm" onclick="exportPhase3PDF()">📄 PDF</button>
      <button class="btn btn-green btn-sm" onclick="exportPhase3DOCX()">📝 DOCX</button>
      <button class="btn btn-orange btn-sm" onclick="exportPhase3HTML()">🌐 HTML</button>
    </div>
  </div>

  <!-- COMBINED EXPORT -->
  <div class="card hidden" id="combined-export-card">
    <div class="card-title">📦 Export All Phases (Combined)</div>
    <div class="export-bar" style="background:transparent; padding:0;">
      <button class="btn btn-blue" onclick="exportCombinedPDF()">📄 Combined PDF</button>
      <button class="btn btn-green" onclick="exportCombinedDOCX()">📝 Combined DOCX</button>
      <button class="btn btn-orange" onclick="exportCombinedHTML()">🌐 Combined HTML</button>
    </div>
  </div>

  <!-- FOOTER -->
  <div style="text-align:center; padding:20px; font-size:0.8rem; color:var(--text-secondary);">
    AI RPP Generator — Kurikulum Merdeka + KBC dengan Deep Learning
    <br>Dibuat untuk membantu guru Indonesia
  </div>

</div>

<script>
// ============================================================
// STATE
// ============================================================
// Alamat Worker default (Pola B: tiap guru pakai key masing-masing).
// Diisi admin sekali setelah Worker jadi, cth:
// const DEFAULT_WORKER_URL = 'https://rpp-poolside.kamu.workers.dev/?url=';
const DEFAULT_WORKER_URL = 'https://rpp.andys-riyans.workers.dev/?url=';
const APP = {
  settings: {
    provider: 'openrouter',
    apiKey: '',
    openRouterKey: '',
    poolsideKey: '',
    model: 'nvidia/nemotron-3-super-120b-a12b:free',
    customModel: '',
    fallbackModel: 'openrouter/free',
    poolsideModel: 'poolside/laguna-s-2.1',
    corsProxy: '',
  },
  input: {},
  phase1: null,
  phase2: null,
  phase3: null,
  currentStep: 0,
};

// ============================================================
// SETTINGS
// ============================================================
function loadSettings() {
  try {
    const saved = localStorage.getItem('rpp_generator_settings');
    if (saved) {
      const parsed = JSON.parse(saved);
      APP.settings = { ...APP.settings, ...parsed };
      // Migrasi: settings lama hanya punya `apiKey` (OpenRouter) — pindahkan agar tidak hilang
      if (APP.settings.apiKey && !APP.settings.openRouterKey) {
        APP.settings.openRouterKey = APP.settings.apiKey;
      }
    }
  } catch(e) { console.warn('Settings load error:', e); }
  // Default SELALU berlaku — termasuk di origin/profil baru yang belum punya simpanan
  // (sebelumnya baris-baris ini hanya jalan bila sudah ada simpanan: bug kolom worker kosong)
  if (!APP.settings.provider) APP.settings.provider = 'openrouter';
  if (!APP.settings.poolsideModel) APP.settings.poolsideModel = 'poolside/laguna-s-2.1';
  if (!APP.settings.corsProxy) APP.settings.corsProxy = DEFAULT_WORKER_URL;
  applySettingsToUI();
}
function applySettingsToUI() {
  document.getElementById('set-provider').value = APP.settings.provider || 'openrouter';
  document.getElementById('api-key').value = APP.settings.openRouterKey || APP.settings.apiKey || '';
  document.getElementById('poolside-key').value = APP.settings.poolsideKey || '';
  document.getElementById('poolside-model').value = APP.settings.poolsideModel || 'poolside/laguna-s-2.1';
  document.getElementById('poolside-proxy').value = APP.settings.corsProxy || '';
  document.getElementById('model-select').value = APP.settings.model === APP.settings.customModel ? 'custom' : APP.settings.model;
  document.getElementById('model-custom').value = APP.settings.customModel || '';
  document.getElementById('fallback-model').value = APP.settings.fallbackModel || 'openrouter/free';
  toggleCustomModel();
  onProviderChange(false);
}
function onProviderChange(save = true) {
  const provider = document.getElementById('set-provider').value;
  const isPoolside = provider === 'poolside';
  document.querySelectorAll('.grp-openrouter').forEach(el => { el.style.display = isPoolside ? 'none' : ''; });
  document.querySelectorAll('.grp-poolside').forEach(el => { el.style.display = isPoolside ? '' : 'none'; });
  document.getElementById('provider-hint').textContent = isPoolside
    ? ((typeof DEFAULT_WORKER_URL !== 'undefined' && DEFAULT_WORKER_URL)
        ? '✓ Terhubung via worker bawaan — cukup isi API key di bawah.'
        : 'Poolside tidak mengizinkan panggilan langsung dari browser — buka Pengaturan lanjutan di bawah.')
    : 'Gunakan API key OpenRouter untuk model-model gratis.';
  document.getElementById('api-status').innerHTML = '';
  if (save) {
    APP.settings.provider = provider;
    localStorage.setItem('rpp_generator_settings', JSON.stringify(APP.settings));
  }
}
function saveSettings() {
  const provider = document.getElementById('set-provider').value;
  const openRouterKey = document.getElementById('api-key').value.trim();
  const poolsideKey = document.getElementById('poolside-key').value.trim();
  const poolsideModel = document.getElementById('poolside-model').value.trim() || 'poolside/laguna-s-2.1';
  const corsProxy = document.getElementById('poolside-proxy').value.trim();
  const modelSel = document.getElementById('model-select').value;
  const custom = document.getElementById('model-custom').value.trim();
  const fallback = document.getElementById('fallback-model').value;
  APP.settings.provider = provider;
  // Simpan kedua key secara terpisah agar tidak saling menimpa
  if (openRouterKey) APP.settings.openRouterKey = openRouterKey;
  if (poolsideKey) APP.settings.poolsideKey = poolsideKey;
  APP.settings.apiKey = APP.settings.openRouterKey || '';
  APP.settings.poolsideModel = poolsideModel;
  APP.settings.corsProxy = corsProxy;
  APP.settings.customModel = custom;
  APP.settings.fallbackModel = fallback;
  APP.settings.model = modelSel === 'custom' ? (custom || 'nvidia/nemotron-3-super-120b-a12b:free') : modelSel;
  localStorage.setItem('rpp_generator_settings', JSON.stringify(APP.settings));
  showToast('Pengaturan tersimpan!', 'success');
}
function toggleSettings() {
  const panel = document.getElementById('settings-panel');
  const body = document.getElementById('settings-body');
  const arrow = document.getElementById('settings-arrow');
  panel.classList.toggle('hidden');
  if (!panel.classList.contains('hidden')) {
    body.style.display = '';
    arrow.textContent = '▼';
  } else {
    arrow.textContent = '▲';
  }
}
function toggleCustomModel() {
  const sel = document.getElementById('model-select').value;
  document.getElementById('model-custom').disabled = sel !== 'custom';
}
document.getElementById('model-select').addEventListener('change', toggleCustomModel);

async function testAPI() {
  const btn = document.querySelector('#settings-body .btn-outline');
  const status = document.getElementById('api-status');
  btn.disabled = true;
  status.innerHTML = '⏳ Testing...';
  const provider = document.getElementById('set-provider').value;
  try {
    if (provider === 'poolside') {
      const key = document.getElementById('poolside-key').value.trim();
      if (!key) { status.innerHTML = '❌ Poolside API Key kosong'; btn.disabled = false; return; }
      // Poolside OpenAI-compatible: daftar model sebagai uji autentikasi.
      // Catatan: Poolside tidak mengirim header CORS, jadi tanpa CORS Proxy browser pasti memblokir.
      const res = await fetch(withCorsProxy('https://inference.poolside.ai/v1/models'), {
        headers: { 'Authorization': `Bearer ${key}` }
      });
      if (res.ok) {
        status.innerHTML = '✅ Poolside: key valid';
        APP.settings.poolsideKey = key;
        APP.settings.provider = 'poolside';
        localStorage.setItem('rpp_generator_settings', JSON.stringify(APP.settings));
      } else {
        const err = await res.json().catch(()=>({}));
        status.innerHTML = `❌ ${err.error?.message || err.message || res.statusText}`;
      }
      btn.disabled = false;
      return;
    }
    const key = document.getElementById('api-key').value.trim();
    if (!key) { status.innerHTML = '❌ API Key kosong'; btn.disabled = false; return; }
    const res = await fetch('https://openrouter.ai/api/v1/auth/key', {
      headers: { 'Authorization': `Bearer ${key}` }
    });
    if (res.ok) {
      const data = await res.json();
      status.innerHTML = `✅ ${data.data?.label || 'Valid'} | Sisa: ${data.data?.limit_remaining ?? '?'}`;
      // Auto-save if test passes
      APP.settings.openRouterKey = key;
      APP.settings.apiKey = key;
      localStorage.setItem('rpp_generator_settings', JSON.stringify(APP.settings));
    } else {
      const err = await res.json().catch(()=>({}));
      status.innerHTML = `❌ ${err.error?.message || res.statusText}`;
    }
  } catch(e) {
    const msg = e.message || String(e);
    if (/failed to fetch|load failed|networkerror/i.test(msg)) {
      status.innerHTML = (provider === 'poolside' && !(APP.settings.corsProxy || '').trim())
        ? '⛔ Browser memblokir request (CORS): Poolside tidak mengizinkan panggilan langsung dari browser. Isi Worker / Proxy URL milik sendiri lalu Test lagi.'
        : `❌ Jaringan diblokir: ${msg}`;
    } else {
      status.innerHTML = `❌ ${msg}`;
    }
  }
  btn.disabled = false;
}

// ============================================================
// TOAST & LOADING
// ============================================================
function showToast(msg, type = 'info') {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  toast.textContent = msg;
  container.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(() => toast.remove(), 300); }, 4000);
}
function showLoading(text = 'Memproses...', sub = 'Mohon tunggu, AI sedang bekerja') {
  document.getElementById('loading-text').textContent = text;
  document.getElementById('loading-sub').textContent = sub;
  document.getElementById('loading-overlay').classList.remove('hidden');
}
function hideLoading() {
  document.getElementById('loading-overlay').classList.add('hidden');
  // Setiap generate berakhir di hideLoading() → bebaskan semua kunci busy di sini (satu titik)
  if (APP._busy) APP._busy = {};
}
function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
// Kunci anti-ganda: cegah 2 generate berjalan bersamaan (klik ganda / console) yang
// membanjiri API dan memicu rate-limit. Kunci dibebaskan otomatis oleh hideLoading().
function enterBusy(key) {
  APP._busy = APP._busy || {};
  if (APP._busy[key]) { showToast('⏳ Masih memproses, tunggu sampai selesai dulu...', 'warning'); return false; }
  APP._busy[key] = true;
  return true;
}

// ============================================================
// WIZARD NAVIGATION
// ============================================================
function showStep(step) {
  APP.currentStep = step;
  document.querySelectorAll('[id^="step-"]').forEach(el => el.classList.add('hidden'));
  document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active', 'done'));
  document.querySelectorAll('.wizard-step').forEach(el => {
    const s = parseInt(el.dataset.step);
    if (s < step) el.classList.add('done');
    else if (s === step) el.classList.add('active');
  });
  const target = document.getElementById(`step-${step}`);
  if (target) {
    target.classList.remove('hidden');
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  // Show combined export if all phases done
  if (APP.phase1 && APP.phase2 && APP.phase3) {
    document.getElementById('combined-export-card').classList.remove('hidden');
  }
}

// ============================================================
// FORM HANDLING
// ============================================================
function collectForm() {
  const get = (id) => document.getElementById(id)?.value?.trim() || '';
  const form = {
    madrasah: get('inp-madrasah'),
    mapel: get('inp-mapel'),
    materi: get('inp-materi'),
    elemen: get('inp-elemen'),
    guru: get('inp-guru'),
    nuptk: get('inp-nuptk'),
    fase: get('inp-fase'),
    tahunPelajaran: get('inp-tahun-pelajaran'),
    alkok: get('inp-alkok'),
    kepsek: get('inp-kepsek'),
    kepsekNuptk: get('inp-kepsek-nuptk'),
    tempat: get('inp-tempat'),
    tanggal: get('inp-tanggal'),
    cp: get('inp-cp'),
    tp: get('inp-tp'),
    atp: get('inp-atp'),
  };
  // Validate required
  const required = { madrasah: 'Nama Madrasah', guru: 'Nama Guru', mapel: 'Mata Pelajaran', fase: 'Fase/Kelas', tahunPelajaran: 'Tahun Ajaran', alkok: 'Alokasi Waktu', kepsek: 'Nama Kepala Madrasah', tempat: 'Tempat', tanggal: 'Tanggal', cp: 'Capaian Pembelajaran', tp: 'Tujuan Pembelajaran' };
  for (const [key, label] of Object.entries(required)) {
    if (!form[key]) { showToast(`❌ "${label}" harus diisi!`, 'error'); return null; }
  }
  APP.input = form;
  return form;
}

// ============================================================
// AI PROVIDER API (OpenRouter & Poolside, OpenAI-compatible)
// ============================================================
const POOLSIDE_BASE = 'https://inference.poolside.ai/v1';
// Poolside tidak mengirim header CORS, sehingga browser memblokir fetch langsung.
// Jika user mengisi CORS proxy, lewatkan request melaluinya.
function withCorsProxy(url) {
  const px = (APP.settings.corsProxy || '').trim();
  if (!px) return url;
  if (px.includes('{url}')) return px.replace('{url}', encodeURIComponent(url));
  return px + encodeURIComponent(url);
}
async function callAIProvider(model, messages, timeoutMs = 120000, maxTokens = 8000) {
  const provider = APP.settings.provider || 'openrouter';
  const key = provider === 'poolside'
    ? (APP.settings.poolsideKey || '')
    : (APP.settings.openRouterKey || APP.settings.apiKey || '');
  if (!key) { throw new Error(provider === 'poolside' ? 'Poolside API Key belum diisi. Buka ⚙️ Pengaturan, pilih provider Poolside.' : 'API Key belum diisi. Buka ⚙️ Pengaturan.'); }
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const isPoolside = provider === 'poolside';
    let url = isPoolside ? `${POOLSIDE_BASE}/chat/completions` : 'https://openrouter.ai/api/v1/chat/completions';
    if (isPoolside) url = withCorsProxy(url);
    const headers = { 'Authorization': `Bearer ${key}`, 'Content-Type': 'application/json' };
    if (!isPoolside) {
      headers['HTTP-Referer'] = window.location.origin || 'https://rpp-generator.github.io';
      headers['X-Title'] = 'AI RPP Generator';
    }
    const body = { model, messages, temperature: 0.3, max_tokens: maxTokens };
    // response_format & top_p hanya didukung OpenRouter — Poolside mengandalkan instruksi JSON + extractJSON
    if (!isPoolside) {
      body.response_format = { type: 'json_object' };
      body.top_p = 0.9;
    }
    const res = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body), signal: controller.signal });
    if (!res.ok) {
      const err = await res.json().catch(()=>({}));
      throw new Error(err.error?.message || err.message || `HTTP ${res.status}: ${res.statusText}`);
    }
    const data = await res.json();
    const msgObj = data.choices?.[0]?.message || {};
    let content = msgObj.content;
    // Model reasoning/agentic (cth. Laguna) kadang menaruh jawaban di reasoning_content
    if (!content && typeof msgObj.reasoning_content === 'string' && msgObj.reasoning_content.trim()) content = msgObj.reasoning_content;
    // Kadang content berupa array parts, bukan string
    if (Array.isArray(content)) content = content.map(p => typeof p === 'string' ? p : (p?.text || '')).join('');
    if (!content) { console.error('[RPP] AI tanpa content, dump respons:', data); throw new Error('AI mengembalikan konten kosong'); }
    return content;
  } finally {
    clearTimeout(timeout);
  }
}
// Alias kompatibilitas (kode lama memanggil callOpenRouter)
async function callOpenRouter(model, messages, timeoutMs, maxTokens) {
  return callAIProvider(model, messages, timeoutMs, maxTokens);
}

async function generateWithFallback(systemPrompt, userPrompt, phaseName, opts = {}) {
  const { maxTokens = 8000, checkCompleteness = null } = opts;
  const provider = APP.settings.provider || 'openrouter';
  const models = [];
  if (provider === 'poolside') {
    // Poolside: satu model (default poolside/laguna-s-2.1), tanpa fallback OpenRouter
    models.push(APP.settings.poolsideModel || 'poolside/laguna-s-2.1');
  } else {
    const model = APP.settings.model;
    const fallback = APP.settings.fallbackModel || 'openrouter/free';
    if (model) models.push(model);
    if (fallback && fallback !== model) models.push(fallback);
    if (!models.length) models.push('openrouter/free');
  }
  const messages = [
    { role: 'system', content: systemPrompt },
    { role: 'user', content: userPrompt }
  ];
  let lastError = null;
  let rateRetried = false; // backoff 429: tepat 1x jeda+ulang per pemanggilan

  const retryMessages = (msg) => [
    { role: 'system', content: systemPrompt },
    { role: 'user', content: userPrompt },
    { role: 'assistant', content: msg },
    { role: 'user', content: 'Response di atas bukan JSON valid. Kembalikan HANYA JSON sesuai struktur yang diminta, tanpa teks apapun di luar JSON. Mulai langsung dengan { dan akhiri dengan }.' }
  ];

  for (const m of models) {
    try {
      showLoading(`Phase ${phaseName}: ${m.split('/').pop()}...`, `Provider: ${provider} | Model: ${m}`);
      const content = await callAIProvider(m, messages, 120000, maxTokens);
      let json = extractJSON(content);
      // Auto-retry once with stricter instruction
      if (!json) {
        showLoading(`Phase ${phaseName}: ${m.split('/').pop()} (ulang)...`, `Meminta JSON valid`);
        const retryContent = await callAIProvider(m, retryMessages(content), 120000, maxTokens);
        json = extractJSON(retryContent);
      }
      if (!json) throw new Error('AI tidak menghasilkan JSON yang valid');
      let validated = validatePhaseJSON(json, phaseName);

      // Completeness check: kalau hasil masih kurang lengkap (jumlah item di bawah minimum),
      // minta model yang sama melengkapi sebelum diterima, alih-alih diam-diam lolos.
      if (checkCompleteness) {
        const first = checkCompleteness(validated);
        if (!first.ok) {
          console.warn(`Kelengkapan kurang (${phaseName}):`, first.issues);
          showLoading(`Phase ${phaseName}: ${m.split('/').pop()} (melengkapi)...`, first.issues.join('; '));
          try {
            const completionMessages = [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: userPrompt },
              { role: 'assistant', content: JSON.stringify(validated) },
              { role: 'user', content: `Hasil di atas BELUM lengkap. Masalah: ${first.issues.join('; ')}. Perbaiki dan kembalikan JSON LENGKAP dengan struktur SAMA, penuhi semua jumlah minimum yang diminta di instruksi sebelumnya. Output HANYA JSON, mulai dengan { dan akhiri dengan }.` }
            ];
            const fixContent = await callAIProvider(m, completionMessages, 120000, maxTokens);
            const fixJson = extractJSON(fixContent);
            if (fixJson) {
              const fixValidated = validatePhaseJSON(fixJson, phaseName);
              const second = checkCompleteness(fixValidated);
              if (second.ok || (fixValidated && JSON.stringify(fixValidated).length > JSON.stringify(validated).length)) {
                validated = fixValidated;
              }
            }
          } catch (fixErr) {
            console.warn('Gagal melengkapi, pakai hasil awal:', fixErr.message);
          }
        }
      }

      return validated;
    } catch (e) {
      // Rate-limit (429): JANGAN langsung hantam ulang — jeda 20 detik lalu coba model
      // yang sama tepat 1x. Mencegah banjir request yang memperparah pembatasan.
      const isRate = /429|too many|rate[\s_-]?limit|quota/i.test(e.message || '');
      if (isRate && !rateRetried) {
        rateRetried = true;
        showToast('⏳ Kena rate-limit API, menunggu 20 detik sebelum coba lagi...', 'warning');
        showLoading(`Phase ${phaseName}: menunggu rate-limit...`, 'Jeda 20 detik, mohon jangan klik apa-apa');
        await sleep(20000);
        try {
          showLoading(`Phase ${phaseName}: ${m.split('/').pop()} (coba lagi)...`, `Provider: ${provider} | Model: ${m}`);
          const content2 = await callAIProvider(m, messages, 120000, maxTokens);
          const json2 = extractJSON(content2);
          if (!json2) throw new Error('AI tidak menghasilkan JSON yang valid');
          return validatePhaseJSON(json2, phaseName);
        } catch (e2) { e = e2; }
      }
      lastError = e;
      console.warn(`Model ${m} gagal:`, e.message);
      const friendlyMsg = friendlyError(e.message);
      if (m !== models[models.length-1]) {
        showToast(`⚠️ ${friendlyMsg} — coba model cadangan...`, 'warning');
      }
    }
  }
  const finalErr = lastError || new Error('Semua model gagal. Cek API Key/provider di ⚙️ Pengaturan.');
  // Simpan error asli agar bisa dilihat di Console tanpa reload (ketik: APP.lastError)
  try { APP.lastError = { phase: phaseName, message: finalErr.message, time: new Date().toISOString() }; } catch(_) {}
  console.error(`[RPP] Phase ${phaseName} gagal:`, finalErr.message);
  throw finalErr;
}

function friendlyError(msg) {
  if (/failed to fetch|load failed|networkerror/i.test(msg)) return 'Browser memblokir koneksi (CORS/jaringan) — untuk Poolside wajib isi Worker / Proxy URL di ⚙️ Pengaturan';
  if (/poolside|laguna/i.test(msg) && /404|not found|model/i.test(msg)) return 'Model Poolside tidak ditemukan — pastikan ID "poolside/laguna-s-2.1"';
  if (/unavailable.*free/i.test(msg)) return 'Model ini sudah tidak gratis';
  if (/404|not found/i.test(msg)) return 'Model tidak ditemukan, mungkin sudah tidak tersedia';
  if (/timeout|aborted/i.test(msg)) return 'Koneksi timeout, coba lagi';
  if (/api.key|unauthorized|403|401/i.test(msg)) return 'API Key tidak valid';
  if (/rate.limit|too many/i.test(msg)) return 'Terlalu banyak permintaan, tunggu sebentar';
  if (/quota|limit/i.test(msg)) return 'Kuota API habis';
  if (/JSON|json/i.test(msg)) return 'AI tidak menghasilkan format JSON yang valid — coba model lain atau generate ulang';
  return msg.split('.')[0] || 'Error tidak diketahui';
}

function extractJSON(text) {
  // Step 1: strip markdown fences
  let cleaned = text.replace(/```json\s*/gi, '').replace(/```\s*/gi, '').trim();

  // Step 2: extract first { ... } block
  const firstBrace = cleaned.indexOf('{');
  const lastBrace = cleaned.lastIndexOf('}');
  if (firstBrace >= 0 && lastBrace > firstBrace) {
    cleaned = cleaned.substring(firstBrace, lastBrace + 1);
  }

  // Step 3: direct parse attempt
  const tryParse = (s) => {
    try { return JSON.parse(s); } catch(e) { return null; }
  };
  let parsed = tryParse(cleaned);
  if (parsed) return parsed;

  // Step 4: repair common issues
  let repaired = cleaned
    .replace(/\\'/g, "'")           // unescape single quotes
    .replace(/\\([^"\\\/bfnrtu])/g, '\\$&')  // escape backslash for JSON validity
    .replace(/,(\s*[}\]])/g, '$1')   // trailing commas
    .replace(/([{,])\s*(\w+)\s*:/g, '$1"$2":')  // unquoted keys
    .replace(/:\s*'([^']*)'/g, ':"$1"')          // single-quoted strings
    .replace(/:\s*'([^']*)'(\s*[},])/g, ':"$1"$2'); // more single quotes

  parsed = tryParse(repaired);
  if (parsed) return parsed;

  // Step 5: try removing newlines inside strings (AI often breaks them)
  repaired = repaired.replace(/\n\s*/g, ' ');
  parsed = tryParse(repaired);
  if (parsed) return parsed;

  // Step 6: last resort — try to salvage partial JSON
  try {
    // Find deepest complete JSON structure
    let best = null;
    let depth = 0, lastGoodEnd = -1;
    for (let i = 0; i < repaired.length; i++) {
      if (repaired[i] === '{') depth++;
      if (repaired[i] === '}') { depth--; if (depth === 0) lastGoodEnd = i; }
    }
    if (lastGoodEnd > 0) {
      const partial = repaired.substring(0, lastGoodEnd + 1);
      parsed = tryParse(partial);
      if (parsed) return parsed;
    }
  } catch(e) {}

  return null;
}

function validatePhaseJSON(json, phaseName) {
  if (!json || typeof json !== 'object') throw new Error('Response bukan JSON object');
  const p = String(phaseName);
  // Sub-phase 1a (RPP Core)
  if (p === '1a' || p === '1') {
    if (!json.rpp) json = { rpp: json };
    if (!json.rpp) throw new Error('Phase RPP Core harus memiliki struktur "rpp"');
  }
  // Sub-phase 1b (LKPD)
  if (p === '1b') {
    if (!json.lkpd) json = { lkpd: json };
    if (!json.lkpd) throw new Error('Phase LKPD harus memiliki struktur "lkpd"');
  }
  // Sub-phase 1c (Evaluasi)
  if (p === '1c') {
    if (!json.evaluasi) json = { evaluasi: json };
    if (!json.evaluasi) throw new Error('Phase Evaluasi harus memiliki struktur "evaluasi"');
  }
  // Sub-phase 1d (Remidial + Pengayaan + Rubrik)
  if (p === '1d') {
    if (!json.programRemidial && !json.programPengayaan && !json.rubrikPenilaian) {
      json = { programRemidial: json.programRemidial || null, programPengayaan: json.programPengayaan || null, rubrikPenilaian: json.rubrikPenilaian || null };
    }
  }
  // Sub-phase 1e (Diagnostik)
  if (p === '1e') {
    if (!json.diagnostik) json = { diagnostik: json };
    if (!json.diagnostik) throw new Error('Phase Diagnostik harus memiliki struktur "diagnostik"');
  }
  if (p === '2') {
    if (!json.modulAjar && !json.bahanAjar) json = { modulAjar: json };
    if (!json.modulAjar && !json.bahanAjar) throw new Error('Phase 2 harus memiliki "modulAjar" atau "bahanAjar"');
  }
  if (p === '3') {
    if (!json.media) json = { media: json };
    if (!json.media) throw new Error('Phase 3 harus memiliki "media"');
  }
  return json;
}

// ============================================================
// FEW-SHOT EXAMPLES (referensi gaya/kedalaman, diambil & dipadatkan
// dari contoh RPP nyata berkualitas tinggi). Ini KUNCI kualitas output
// terutama untuk model gratis yang butuh contoh konkret, bukan cuma skema kosong.
// ============================================================
function fewshotNote(materiAsli) {
  return `\n\nPERINGATAN: Contoh di atas topiknya adalah "Sel Hewan dan Sel Tumbuhan" HANYA untuk referensi gaya bahasa, kedalaman, dan struktur JSON. JANGAN salin topik/istilah biologinya. Materi yang HARUS kamu buat adalah "${materiAsli}" — sesuaikan seluruh isi sepenuhnya dengan materi ini.`;
}

function buildContextSummary(context) {
  const rpp = context?.rpp;
  if (!rpp) return '';
  const desain = rpp.desainPembelajaran || {};
  const langkah = rpp.langkahPembelajaran || {};
  const topik = (desain.topikPembelajaran || []).join('; ');
  const tp = (desain.tujuanPembelajaran || []).join('; ');
  const model = desain.praktekPedagogis?.modelPembelajaran || '';
  const tahapNama = (langkah.kegiatanInti?.tahap || []).map(t => t.nama).join(', ');
  if (!topik && !tp && !model) return '';
  return `\n\nKONTEKS DARI RPP INTI YANG SUDAH DIBUAT SEBELUMNYA (WAJIB konsisten dengan ini, jangan bertentangan):\n- Topik Pembelajaran: ${topik}\n- Tujuan Pembelajaran: ${tp}\n- Model Pembelajaran: ${model}\n- Tahapan Kegiatan Inti: ${tahapNama}`;
}

