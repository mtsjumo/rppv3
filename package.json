{
  "name": "ai-rpp-generator-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Generator RPP, Modul Ajar, dan Media Pembelajaran berbasis AI — v3 dengan Puter.js (User-Pays). Kurikulum Merdeka + KBC dengan Deep Learning",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"*.{html,json,yml,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"*.{html,json,yml,md}\"",
    "pretest": "vite build",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
