  }

  // Call API with model+fallback
  const result = await generateWithFallback(systemPrompt, userPrompt, `1${sp.id}`, {
    maxTokens: sp.maxTokens || 8000,
    checkCompleteness: COMPLETENESS_CHECKERS[sp.id] || null
  });
  return result;
}

function buildPhase1Object(merged) {
  return {
    rpp: merged.rpp || {},
    lampiran: {
      lkpd: merged.lkpd || null,
      evaluasi: merged.evaluasi || null,
      programRemidial: merged.programRemidial || null,
      programPengayaan: merged.programPengayaan || null,
      rubrikPenilaian: merged.rubrikPenilaian || null,
      diagnostik: merged.diagnostik || null
    }
  };
}
// Reset Phase 2 & 3 saat Phase 1 digenerate ulang — mencegah dokumen basi yang
// tidak nyambung dengan RPP baru ikut ter-export.
function resetDownstreamPhases() {
  APP.phase2 = null;
  APP.phase3 = null;
  const emptyPhase = (statusId, previewId, exportId, icon, text) => {
    const st = document.getElementById(statusId);
    if (st) { st.className = 'phase-status pending'; st.textContent = '⏳ Belum digenerate'; }
    const pv = document.getElementById(previewId);
    if (pv) pv.innerHTML = `<div class="preview-empty"><div class="icon">${icon}</div><p>${text}</p></div>`;
    const ex = document.getElementById(exportId);
    if (ex) ex.classList.add('hidden');
  };
  emptyPhase('phase2-status', 'phase2-preview', 'phase2-export', '📖', 'Generate Modul Ajar setelah RPP selesai.');
  emptyPhase('phase3-status', 'phase3-preview', 'phase3-export', '🎬', 'Generate Media Pembelajaran setelah Modul Ajar selesai.');
  document.getElementById('combined-export-card').classList.add('hidden');
}

async function startPhase1() {
  const input = collectForm();
  if (!input) return;

  // Navigate to step 1 to show progress
  showStep(1);

  // Show progress bar
  document.getElementById('phase1-progress').classList.remove('hidden');
  document.getElementById('phase1-gen-btn').disabled = true;
  document.getElementById('phase1-status').className = 'phase-status loading';
  document.getElementById('phase1-status').textContent = '⏳ Mengenerate...';
  if (!enterBusy('phase1')) { document.getElementById('phase1-gen-btn').disabled = false; return; }

  // Phase 1 baru = Phase 2 & 3 lama tidak berlaku lagi → kosongkan agar tak campur aduk
  if (APP.phase2 || APP.phase3) {
    resetDownstreamPhases();
    showToast('ℹ️ Phase 1 digenerate ulang — Modul Ajar & Media lama dikosongkan.', 'warning');
  }

  const merged = {};
  let successCount = 0;

  try {
    for (let i = 0; i < SUBPHASES.length; i++) {
      const sp = SUBPHASES[i];
      const isLast = i === SUBPHASES.length - 1;

      // Build step status list
      const stepList = SUBPHASES.map((s, idx) => ({
        ...s,
        done: idx < i,
        active: idx === i,
        pending: idx > i
      }));

      updateProgress(Math.round((i / SUBPHASES.length) * 100), sp.label, stepList);

      const retries = 2;
      let lastError = null;

      for (let attempt = 1; attempt <= retries; attempt++) {
        try {
          const subResult = await generateSubPhase(i, merged);
          Object.assign(merged, subResult);
          successCount++;
          break; // success, move to next sub-phase
        } catch (e) {
          lastError = e;
          if (attempt < retries) {
            showToast(`⚠️ ${sp.label} percobaan ${attempt} gagal, coba lagi...`, 'warning');
            updateProgress(Math.round((i / SUBPHASES.length) * 100), `${sp.label} (ulang ${attempt})...`, stepList);
            // Rate-limit: jeda 10 detik sebelum percobaan ke-2 (di luar backoff internal GW)
            if (/429|too many|rate[\s_-]?limit|quota/i.test(lastError.message || '')) {
              updateProgress(Math.round((i / SUBPHASES.length) * 100), `${sp.label}: rate-limit, jeda 10 detik...`, stepList);
              await sleep(10000);
            }
          }
        }
      }

      if (lastError && successCount <= i) {
        // This sub-phase failed after retries
        if (i === 0) {
          throw new Error(`${sp.label} gagal setelah ${retries}x percobaan: ${lastError.message}`);
        }
        // Non-critical sub-phase failed, warn but continue
        showToast(`⚠️ ${sp.label} gagal, lanjut ke bagian berikutnya`, 'warning');
      }

      // Pacing: jeda 5 detik antar sub-phase agar tidak memicu rate-limit API
      if (!isLast) {
        updateProgress(Math.round(((i + 1) / SUBPHASES.length) * 100), `${sp.label} selesai — jeda 5 detik...`, stepList);
        await sleep(5000);
      }
    }

    // Final progress
    updateProgress(100, 'Selesai!', SUBPHASES.map(s => ({ ...s, done: true, active: false, pending: false })));

    // Validate merged result has minimum structure — RPP Core is mandatory
    if (!merged.rpp) {
      throw new Error('RPP Core tidak berhasil digenerate. Coba lagi.');
    }

    APP.phase1 = buildPhase1Object(merged);

    document.getElementById('phase1-status').className = 'phase-status success';
    document.getElementById('phase1-status').textContent = '✅ Selesai';
    renderPhase1(APP.phase1);
    document.getElementById('phase1-export').classList.remove('hidden');
    document.getElementById('phase1-regenerate').classList.remove('hidden');
    document.getElementById('phase1-back').classList.remove('hidden');
    updateWizardStep(1, 'done');
    showToast(`✅ RPP + Lampiran berhasil digenerate (${successCount}/${SUBPHASES.length} bagian)!`, 'success');
  } catch (e) {
    document.getElementById('phase1-status').className = 'phase-status error';
    document.getElementById('phase1-status').textContent = '❌ Gagal';
    updateProgress(0, `❌ Gagal: ${e.message}`, SUBPHASES.map(s => ({ ...s, done: false, active: false, pending: true })));
    showToast(`❌ ${e.message}`, 'error');
    // Partial-save: bagian yang sempat jadi tetap disimpan — bisa di-export
    // atau dilengkapi via Regenerate per bagian, tidak hilang total.
    if (merged.rpp || merged.lkpd) {
      APP.phase1 = buildPhase1Object(merged);
      try {
        renderPhase1(APP.phase1);
        document.getElementById('phase1-export').classList.remove('hidden');
        document.getElementById('phase1-regenerate').classList.remove('hidden');
        document.getElementById('phase1-back').classList.remove('hidden');
        showToast(`💾 Hasil sebagian tersimpan (${successCount}/${SUBPHASES.length} bagian).`, 'warning');
      } catch(_) {}
    }
  } finally {
    document.getElementById('phase1-gen-btn').disabled = false;
    hideLoading();
  }
}

async function regeneratePart(partIndex) {
  if (!APP.phase1) return showToast('Belum ada data Phase 1!', 'warning');
  const sp = SUBPHASES[partIndex];
  if (!confirm(`Apakah Anda yakin ingin meng-generate ulang "${sp.label}"? Bagian ini akan diganti dengan hasil baru.`)) return;
  if (!enterBusy('regen')) return;

  showLoading(`Meng-generate ulang ${sp.label}...`);
  try {
    // Gunakan data gabungan yang ada saat ini sebagai context
    const currentMerged = {
      rpp: APP.phase1.rpp,
      lkpd: APP.phase1.lampiran.lkpd,
      evaluasi: APP.phase1.lampiran.evaluasi,
      programRemidial: APP.phase1.lampiran.programRemidial,
      programPengayaan: APP.phase1.lampiran.programPengayaan,
      rubrikPenilaian: APP.phase1.lampiran.rubrikPenilaian,
      diagnostik: APP.phase1.lampiran.diagnostik
    };

    const newResult = await generateSubPhase(partIndex, currentMerged);
    
    // Update data di APP.phase1
    if (partIndex === 0 && newResult.rpp) {
      APP.phase1.rpp = newResult.rpp;
    } else if (partIndex === 1 && newResult.lkpd) {
      APP.phase1.lampiran.lkpd = newResult.lkpd;
    } else if (partIndex === 2 && newResult.evaluasi) {
      APP.phase1.lampiran.evaluasi = newResult.evaluasi;
    } else if (partIndex === 3) {
      if (newResult.programRemidial) APP.phase1.lampiran.programRemidial = newResult.programRemidial;
      if (newResult.programPengayaan) APP.phase1.lampiran.programPengayaan = newResult.programPengayaan;
      if (newResult.rubrikPenilaian) APP.phase1.lampiran.rubrikPenilaian = newResult.rubrikPenilaian;
    } else if (partIndex === 4 && newResult.diagnostik) {
      APP.phase1.lampiran.diagnostik = newResult.diagnostik;
    }

    renderPhase1(APP.phase1);
    showToast(`✅ Berhasil meng-generate ulang ${sp.label}!`, 'success');
  } catch (e) {
    showToast(`❌ Gagal meng-generate ${sp.label}: ${e.message}`, 'error');
  } finally {
    hideLoading();
  }
}

function renderPhase1(json) {
  const container = document.getElementById('phase1-preview');
  container.innerHTML = renderCodeCogs(buildRPPHTML(json));
}

function updateWizardStep(step, state) {
  const el = document.querySelector(`.wizard-step[data-step="${step}"]`);
  if (el) {
    el.classList.remove('active', 'done');
    if (state === 'done') el.classList.add('done');
    else if (state === 'active') el.classList.add('active');
  }
}

// Rich text helper: escape HTML + render blok tabel markdown (| a | b |) menjadi <table>
// Dipakai untuk teks soal agar tabel data dari AI tampil sebagai tabel betulan, bukan teks mentah.
function richText(s) {
  const escRT = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const lines = String(s ?? '').split('\n');
  const splitRow = (l) => {
    let t = l.trim();
    if (t.startsWith('|')) t = t.slice(1);
    if (t.endsWith('|')) t = t.slice(0, -1);
    return t.split('|').map(c => c.trim());
  };
  const isSepRow = (l) => {
    if (!l.includes('|')) return false;
    const cells = splitRow(l);
    return cells.length > 0 && cells.every(c => /^:?-{2,}:?$/.test(c));
  };
  const segs = [];
  let buf = [];
  const flush = () => { if (buf.length) { segs.push(buf.map(escRT).join('<br>')); buf = []; } };
  let i = 0;
  while (i < lines.length) {
    const line = lines[i];
    if (line.includes('|') && i + 1 < lines.length && isSepRow(lines[i + 1])) {
      const headers = splitRow(line);
      i += 2;
      const rows = [];
      while (i < lines.length && lines[i].includes('|') && lines[i].trim() !== '' && !isSepRow(lines[i])) {
        rows.push(splitRow(lines[i]));
        i++;
      }
      const ncols = headers.length;
      const h = headers.map(c => `<th>${escRT(c)}</th>`).join('');
      const r = rows.map(row => {
        let cells = '';
        for (let k = 0; k < ncols; k++) cells += `<td>${escRT(row[k] ?? '')}</td>`;
        return `<tr>${cells}</tr>`;
      }).join('');
      flush();
      segs.push(`<div style="overflow-x:auto;margin:8px 0;"><table><thead><tr>${h}</tr></thead><tbody>${r}</tbody></table></div>`);
      continue;
    }
    if (line.trim() === '') { flush(); i++; continue; }
    buf.push(line);
    i++;
  }
  flush();
  return segs.join('');
}

// ============================================================
// TEMPLATE RENDERER
// ============================================================
function buildRPPHTML(json) {
  const rpp = json.rpp || json;
  const lamp = json.lampiran || {};
  const ident = rpp.identifikasi || {};
  const desain = rpp.desainPembelajaran || {};
  const langkah = rpp.langkahPembelajaran || {};
  const asesmen = rpp.asesmen || {};
  const pengesahan = rpp.pengesahan || {};
  const input = APP.input;
  const today = input.tanggal ? new Date(input.tanggal + 'T00:00:00').toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
  const tempatTanggal = `${input.tempat || ''}${input.tempat && today ? ', ' : ''}${today || ''}`;

  function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function list(items, tag='ol') {
    if (!Array.isArray(items) || items.length === 0) return '';
    const li = items.map(i => {
      if (typeof i === 'string') return `<li>${esc(i)}</li>`;
      if (typeof i === 'object' && i.nama && i.detail) return `<li><strong>${esc(i.nama)}:</strong> ${esc(i.detail)}</li>`;
      if (typeof i === 'object' && i.pertanyaan) return `<li><strong>${esc(i.pertanyaan)}</strong>${i.jawaban ? `<br><em>Jawaban: ${esc(i.jawaban)}</em>` : ''}</li>`;
      return '';
    }).join('');
    return `<${tag}>${li}</${tag}>`;
  }
  function table(headers, rows) {
    if (!Array.isArray(rows) || rows.length === 0) return '';
    const h = headers.map(h => `<th>${esc(h)}</th>`).join('');
    const r = rows.map(row => {
      let cells;
      if (Array.isArray(row)) {
        // Baris berbasis array (dari AI): urutan sel = urutan header, tidak bergantung nama key.
        cells = headers.map((_, idx) => `<td>${esc(row[idx] ?? '')}</td>`).join('');
      } else {
        cells = headers.map(h => {
          let val = typeof row === 'object' ? row[h] || row[Object.keys(row).find(k => {
            const hl = h.toLowerCase().replace(/[^a-z]/g,'');
            const kl = k.toLowerCase().replace(/[^a-z]/g,'');
            return kl === hl || kl.includes(hl) || hl.includes(kl);
          })] : row;
          return `<td>${esc(val || '')}</td>`;
        }).join('');
      }
      return `<tr>${cells}</tr>`;
    }).join('');
    return `<table><thead><tr>${h}</tr></thead><tbody>${r}</tbody></table>`;
  }

  let html = `<div class="rpp-document">`;

  // TITLE
  html += `<div class="doc-title">RENCANA PELAKSANAAN PEMBELAJARAN</div>`;
  html += `<div class="doc-subtitle">PEMBELAJARAN DEEP LEARNING DENGAN KURIKULUM BERBASIS CINTA (KBC)</div>`;
  html += `<table>
    <tr><td style="width:200px"><strong>Nama Madrasah</strong></td><td>: ${esc(input.madrasah || '')}</td></tr>
    <tr><td><strong>Nama Guru</strong></td><td>: ${esc(input.guru || '')}</td></tr>
              <tr><td><strong>NUPTK</strong></td><td>: ${esc(input.nuptk || '-')}</td></tr>
    <tr><td><strong>Mata Pelajaran</strong></td><td>: ${esc(input.mapel || '')}</td></tr>
    <tr><td><strong>Materi Pelajaran</strong></td><td>: ${esc(input.materi || '')}</td></tr>
    <tr><td><strong>Elemen</strong></td><td>: ${esc(input.elemen || '')}</td></tr>
    <tr><td><strong>Fase/Kelas/Smt</strong></td><td>: ${esc(input.fase || '')}</td></tr>
    <tr><td><strong>Tahun Ajaran</strong></td><td>: ${esc(input.tahunPelajaran || '')}</td></tr>
    <tr><td><strong>Alokasi Waktu</strong></td><td>: ${esc(input.alkok || '')}</td></tr>
  </table>`;

  // IDENTIFIKASI
  html += `<div class="section-header">IDENTIFIKASI</div>`;
  html += `<table>
    <tr><td style="width:200px"><strong>Peserta Didik</strong></td><td>${esc(ident.pesertaDidik || '')}</td></tr>
    <tr><td><strong>Materi Pelajaran</strong></td><td>${esc(ident.materiPelajaran || '')}</td></tr>
    <tr><td><strong>Dimensi Profil Lulusan</strong></td><td>${list(ident.dimensiProfilLulusan || [], 'ol')}</td></tr>
    <tr><td><strong>Tema Kurikulum Cinta</strong></td><td>${list(ident.temaKurikulumCinta || [], 'ol')}</td></tr>
    <tr><td><strong>Materi Integrasi KBC</strong></td><td>${list(ident.materiIntegrasiKBC || [], 'ol')}</td></tr>
  </table>`;

  // DESAIN PEMBELAJARAN
  html += `<div class="section-header">DESAIN PEMBELAJARAN</div>`;
  html += `<table>
    <tr><td style="width:200px"><strong>Capaian Pembelajaran</strong></td><td>${esc(desain.capaianPembelajaran || '')}</td></tr>`;
  if (desain.lintasDisiplinIlmu?.length) {
    html += `<tr><td><strong>Lintas Disiplin Ilmu</strong></td><td>${list(desain.lintasDisiplinIlmu, 'ol')}</td></tr>`;
  }
  html += `<tr><td><strong>Tujuan Pembelajaran</strong></td><td>${list(desain.tujuanPembelajaran || [], 'ol')}</td></tr>
    <tr><td><strong>Topik Pembelajaran</strong></td><td>${list(desain.topikPembelajaran || [], 'ol')}</td></tr>`;
  if (desain.praktekPedagogis) {
    html += `<tr><td><strong>Model Pembelajaran</strong></td><td>${esc(desain.praktekPedagogis.modelPembelajaran || '')}</td></tr>`;
    if (desain.praktekPedagogis.sintaks?.length) {
      html += `<tr><td><strong>Sintaks</strong></td><td>${list(desain.praktekPedagogis.sintaks, 'ol')}</td></tr>`;
    }
    if (desain.praktekPedagogis.metode?.length) {
      html += `<tr><td><strong>Metode</strong></td><td>${list(desain.praktekPedagogis.metode, 'ol')}</td></tr>`;
    }
  }
  if (desain.kemitraanPembelajaran?.length) {
    html += `<tr><td><strong>Kemitraan</strong></td><td>${list(desain.kemitraanPembelajaran, 'ol')}</td></tr>`;
  }
  if (desain.lingkunganPembelajaran) {
    html += `<tr><td><strong>Lingkungan Pembelajaran</strong></td><td>${esc(desain.lingkunganPembelajaran.ruangFisik || '')}</td></tr>`;
    if (desain.lingkunganPembelajaran.budayaBelajar) {
      html += `<tr><td><strong>Budaya Belajar</strong></td><td>${esc(desain.lingkunganPembelajaran.budayaBelajar)}</td></tr>`;
    }
    if (desain.lingkunganPembelajaran.penerapanNyata?.length) {
      html += `<tr><td><strong>Penerapan Nyata</strong></td><td>${list(desain.lingkunganPembelajaran.penerapanNyata, 'ol')}</td></tr>`;
    }
  }
  if (desain.pemanfaatanDigital?.length) {
    html += `<tr><td><strong>Pemanfaatan Digital</strong></td><td>${list(desain.pemanfaatanDigital, 'ol')}</td></tr>`;
  }
  html += `</table>`;

  // DIFERENSIASI PEMBELAJARAN
  if (rpp.diferensiasiPembelajaran) {
    html += `<div class="section-header">DIFERENSIASI PEMBELAJARAN</div>`;
    html += `<table>
      <tr><td style="width:200px"><strong>Diferensiasi Konten</strong></td><td>${esc(rpp.diferensiasiPembelajaran.konten || '')}</td></tr>
      <tr><td><strong>Diferensiasi Proses</strong></td><td>${esc(rpp.diferensiasiPembelajaran.proses || '')}</td></tr>
      <tr><td><strong>Diferensiasi Produk</strong></td><td>${esc(rpp.diferensiasiPembelajaran.produk || '')}</td></tr>
    </table>`;
  }

  // LANGKAH PEMBELAJARAN
  html += `<div class="section-header">LANGKAH-LANGKAH PEMBELAJARAN</div>`;
  if (langkah.prinsip?.length) {
    html += `<table><tr><td><strong>Prinsip Deep Learning</strong></td><td>${list(langkah.prinsip, 'ol')}</td></tr></table>`;
  }
  if (langkah.kegiatanAwal) {
    html += `<div class="sub-header">Kegiatan Awal (${esc(langkah.kegiatanAwal.durasi || '10 menit')})</div>`;
    html += list(langkah.kegiatanAwal.langkah || [], 'ol');
  }
  if (langkah.kegiatanInti) {
    html += `<div class="sub-header">Kegiatan Inti (${esc(langkah.kegiatanInti.durasi || '50 menit')})</div>`;
    if (langkah.kegiatanInti.tahap?.length) {
      for (const t of langkah.kegiatanInti.tahap) {
        html += `<div style="font-weight:600;margin:8px 0 4px;">${esc(t.nama || '')}</div>`;
        html += list(t.langkah || [], 'ol');
      }
    } else {
      html += list(langkah.kegiatanInti.langkah || [], 'ol');
    }
  }
  if (langkah.kegiatanPenutup) {
    html += `<div class="sub-header">Kegiatan Penutup (${esc(langkah.kegiatanPenutup.durasi || '10 menit')})</div>`;
    html += list(langkah.kegiatanPenutup.langkah || [], 'ol');
  }

  // ASESMEN
  html += `<div class="section-header">ASESMEN PEMBELAJARAN</div>`;
  html += `<table>`;
  if (asesmen.asesmenAwal?.length) html += `<tr><td style="width:160px"><strong>Asesmen Awal</strong></td><td>${list(asesmen.asesmenAwal, 'ol')}</td></tr>`;
  if (asesmen.asesmenProses?.length) html += `<tr><td><strong>Asesmen Proses</strong></td><td>${list(asesmen.asesmenProses, 'ol')}</td></tr>`;
  if (asesmen.asesmenAkhir?.length) html += `<tr><td><strong>Asesmen Akhir</strong></td><td>${list(asesmen.asesmenAkhir, 'ol')}</td></tr>`;
  html += `</table>`;

  // PENGESAHAN
  html += `<div class="pengesahan">`;
  html += `<table class="pengesahan-table">
    <tr>
      <td>Mengetahui,<br><strong>Kepala Madrasah</strong><br><br><br><br><span class="nama">${esc(input.kepsek || '')}</span><br><span class="nuptk">${input.kepsekNuptk ? `NUPTK: ${esc(input.kepsekNuptk)}` : ''}</span></td>
      <td>${esc(input.tempat || '')}${tempatTanggal ? ', ' : ''}${esc(today || '')}<br><strong>Guru Pengampu</strong><br><br><br><br><span class="nama">${esc(input.guru || '')}</span><br><span class="nuptk">${input.nuptk ? `NUPTK: ${esc(input.nuptk)}` : ''}</span></td>
    </tr>
  </table>`;
  html += `</div>`;

  // LAMPIRAN: DIAGNOSTIK
  if (lamp.diagnostik) {
    const dg = lamp.diagnostik;
    html += `<div class="section-header" style="page-break-before:always;padding-top:40px;">LAMPIRAN: TES DIAGNOSTIK AWAL KOGNITIF</div>`;
    if (dg.soal?.length) {
      html += `<div class="sub-header">Soal Tes Diagnostik</div>`;
      for (const s of dg.soal) {
        html += `<div class="soal-nomor"><strong>${s.nomor}.</strong> <span>${richText(s.pertanyaan)}</span></div>`;
        if (s.opsi?.length) {
          const labels = ['A', 'B', 'C', 'D'];
          for (let i = 0; i < s.opsi.length; i++) {
            const txt = String(s.opsi[i] ?? '').replace(/^[A-Da-d][.\s)]+\s*/, '');
            html += `<div class="soal-opsi">${labels[i]}. ${richText(txt)}</div>`;
          }
        }
        if (s.kunci) html += `<div class="soal-opsi kunci-jawaban">Kunci: ${esc(s.kunci)}</div>`;
      }
    }
    if (dg.rubrik) {
      html += `<div class="sub-header">Rubrik Interpretasi Hasil</div>`;
      if (dg.rubrik.aspek?.length) {
        html += `<div><strong>Aspek yang dinilai:</strong> ${esc(dg.rubrik.aspek.join(', '))}</div><br>`;
      }
      if (dg.rubrik.interpretasi?.length) {
        const h = ['Rentang Skor', 'Kategori', 'Tindak Lanjut'];
        const rows = dg.rubrik.interpretasi.map(r => ({
          'Rentang Skor': r.rentangSkor || '',
          'Kategori': r.kategori || '',
          'Tindak Lanjut': r.tindakLanjut || ''
        }));
        html += table(h, rows);
      }
    }
  }

  // LAMPIRAN: LKPD
  if (lamp.lkpd) {
    const lkpd = lamp.lkpd;
    html += `<div class="section-header" style="page-break-before:always;padding-top:40px;">LAMPIRAN: LEMBAR KERJA PESERTA DIDIK (LKPD)</div>`;
    html += `<table>
      <tr><td style="width:180px"><strong>Mata Pelajaran</strong></td><td>${esc(lkpd.identitas?.mataPelajaran || '')}</td></tr>
      <tr><td><strong>Kelas/Semester</strong></td><td>${esc(lkpd.identitas?.kelasSemester || '')}</td></tr>
      <tr><td><strong>Materi Pokok</strong></td><td>${esc(lkpd.identitas?.materiPokok || '')}</td></tr>
      <tr><td><strong>Alokasi Waktu</strong></td><td>${esc(lkpd.identitas?.alokasiWaktu || '')}</td></tr>
    </table>`;
    if (lkpd.tujuan?.length) html += `<div class="sub-header">Tujuan Pembelajaran</div>${list(lkpd.tujuan, 'ol')}`;
    if (lkpd.aktivitas?.length) {
      for (const a of lkpd.aktivitas) {
        html += `<div class="sub-header">${esc(a.nama || '')}</div>`;
        if (a.deskripsi) html += `<p>${esc(a.deskripsi)}</p>`;
        if (a.tugas?.length) html += list(a.tugas, 'ol');
      }
    }
    if (lkpd.tabelPerbandingan?.data?.length) {
      const tabelJudul = lkpd.tabelPerbandingan.judul || `Tabel Perbandingan — ${input.materi || ''}`;
      html += `<div class="sub-header">${esc(tabelJudul)}</div>`;
      const cols = lkpd.tabelPerbandingan.kolom || ['No', 'Aspek', 'Keterangan'];
      html += table(cols, lkpd.tabelPerbandingan.data);
    }
    if (lkpd.pertanyaan?.length) {
      html += `<div class="sub-header">Pertanyaan Pemahaman</div>${list(lkpd.pertanyaan, 'ol')}`;
    }
  }

  // LAMPIRAN: EVALUASI
  if (lamp.evaluasi?.soal?.length) {
    html += `<div class="section-header">LAMPIRAN: SOAL EVALUASI</div>`;
    for (const s of lamp.evaluasi.soal) {
      const levelSpan = s.level ? ` <span style="font-size:0.8rem;background:#eee;padding:2px 6px;border-radius:4px;color:#555;">${esc(s.level)}</span>` : '';
      html += `<div class="soal-nomor"><strong>${s.nomor}.</strong> <span>${richText(s.pertanyaan)}</span>${levelSpan}</div>`;
      if (s.opsi?.length) {
        const labels = ['A', 'B', 'C', 'D'];
        for (let i = 0; i < s.opsi.length; i++) {
          const txt = String(s.opsi[i] ?? '').replace(/^[A-Da-d][.\s)]+\s*/, '');
          html += `<div class="soal-opsi">${labels[i]}. ${richText(txt)}</div>`;
        }
      }
      if (s.kunci) html += `<div class="soal-opsi kunci-jawaban">Kunci: ${esc(s.kunci)}</div>`;
    }
    if (lamp.evaluasi.penskoran) html += `<p style="margin-top:8px;"><strong>Penskoran:</strong> ${esc(lamp.evaluasi.penskoran)}</p>`;
  }

  // LAMPIRAN: REMIDIAL & PENGAYAAN
  if (lamp.programRemidial?.langkah?.length) {
    html += `<div class="section-header">LAMPIRAN: PROGRAM REMIDIAL</div>`;
    if (lamp.programRemidial.deskripsi) html += `<p>${esc(lamp.programRemidial.deskripsi)}</p>`;
    html += list(lamp.programRemidial.langkah, 'ol');
  }
  if (lamp.programPengayaan?.langkah?.length) {
    html += `<div class="section-header">LAMPIRAN: PROGRAM PENGAYAAN</div>`;
    if (lamp.programPengayaan.deskripsi) html += `<p>${esc(lamp.programPengayaan.deskripsi)}</p>`;
    html += list(lamp.programPengayaan.langkah, 'ol');
  }

  // LAMPIRAN: RUBRIK
  if (lamp.rubrikPenilaian?.diskusi?.aspek?.length) {
    html += `<div class="section-header">LAMPIRAN: RUBRIK PENILAIAN DISKUSI</div>`;
    const h = ['Aspek', 'Sangat Baik (4)', 'Baik (3)', 'Cukup (2)', 'Perlu Bimbingan (1)'];
    const rows = lamp.rubrikPenilaian.diskusi.aspek.map(a => ({
      'Aspek': a.nama || '',
      'Sangat Baik (4)': a.sb || a.SB || '',
      'Baik (3)': a.b || a.B || '',
      'Cukup (2)': a.c || a.C || '',
      'Perlu Bimbingan (1)': a.pb || a.PB || ''
    }));
    html += table(h, rows);
  }
  if (lamp.rubrikPenilaian?.presentasi?.aspek?.length) {
    html += `<div class="section-header">LAMPIRAN: RUBRIK PENILAIAN PRESENTASI</div>`;
    const h = ['Aspek', 'Sangat Baik (4)', 'Baik (3)', 'Cukup (2)', 'Perlu Bimbingan (1)'];
    const rows = lamp.rubrikPenilaian.presentasi.aspek.map(a => ({
      'Aspek': a.nama || '',
      'Sangat Baik (4)': a.sb || a.SB || '',
      'Baik (3)': a.b || a.B || '',
      'Cukup (2)': a.c || a.C || '',
      'Perlu Bimbingan (1)': a.pb || a.PB || ''
    }));
    html += table(h, rows);
  }

  html += `</div>`;
  return html;
}

// ============================================================
// PHASE 2: MODUL AJAR
// ============================================================
async function startPhase2() {
  if (!APP.phase1) { showToast('Generate RPP (Phase 1) dulu!', 'warning'); return; }
  const btn = document.getElementById('phase2-gen-btn');
  btn.disabled = true;
  if (!enterBusy('phase2')) { btn.disabled = false; return; }
  try {
    const rppData = APP.phase1;
    const desain = rppData.rpp?.desainPembelajaran || rppData.desainPembelajaran || {};
    const ident = rppData.rpp?.identifikasi || rppData.identifikasi || {};
    const input = APP.input;

    const systemPrompt = `Kamu adalah AI pembuat Modul Ajar Kurikulum Merdeka untuk MTs/SMP Indonesia. Output HANYA JSON valid, tidak ada teks lain.

STRUKTUR JSON:
{
  "modulAjar": {
    "bahanAjar": {
      "pengertian": "paragraf panjang tentang materi",
      "subBab": [{ "judul": "", "konten": "", "contoh": "", "gambar": "" }]
    },
    "ringkasanMateri": [{ "konsep": "", "definisi": "", "contoh": "" }],
    "glosarium": [{ "istilah": "", "definisi": "" }],
    "mindmap": { "topik": "", "cabang": [{ "nama": "", "rincian": [] }] },
    "faq": [{ "pertanyaan": "", "jawaban": "" }],
    "referensi": [{ "sumber": "", "tautan": "" }],
    "refleksiGuru": {
      "pertanyaanRefleksi": ["pertanyaan refleksi 1", "pertanyaan refleksi 2", "pertanyaan refleksi 3"],
      "hal_yang_berhasil": "",
      "hal_yang_perlu_diperbaiki": ""
    }
  }
}

ATURAN:
1. Bahasa Indonesia baku (EYD), formal-akademik
2. Bahan ajar MENDALAM dan KOMPREHENSIF sesuai materi pembelajaran
3. Sub-bab minimal 3, mencakup semua aspek materi
4. Glosarium minimal 8 istilah penting
5. FAQ minimal 3 pertanyaan antisipasi siswa
6. Mindmap dengan minimal 3 cabang utama
7. Referensi minimal 3 sumber
8. Sertakan bagian Refleksi Guru untuk evaluasi pembelajaran
9. NOTASI SAINTIFIK/MATEMATIS WAJIB LaTeX: setiap rumus, persamaan, pecahan, pangkat/indeks,
   reaksi kimia, dan simbol WAJIB dibungkus \\(...\\) (inline) atau \\[...\\] (display).
   Lihat detail dan contoh di prompt pengguna.
10. DILARANG memakai $...$ untuk rumus — selalu \\(...\\) / \\[...\\].`;

    const userPrompt = `Buat Modul Ajar untuk:
- Madrasah: ${input.madrasah}
- Mata Pelajaran: ${input.mapel}
- Materi: ${input.materi}
- Elemen: ${input.elemen}
- Fase/Kelas: ${input.fase}
- CP: ${desain.capaianPembelajaran || input.cp}
- TP: ${(desain.tujuanPembelajaran || [input.tp]).join('; ')}
- Topik: ${(desain.topikPembelajaran || []).join('; ')}

Ekspresi matematika pakai \\(...\\) (inline) atau \\[...\\] (display) LaTeX. Aksara Arab/Jawa tulis langsung.

NOTASI SAINTIFIK & MATEMATIS (WAJIB agar tampil sebagai rumus, bukan teks polos):
- Berlaku di SEMUA field teks: pengertian, konten sub-bab, contoh, definisi, jawaban FAQ.
- Contoh BENAR: \\(H_{2}SO_{4}\\), \\(x^{2} + 3x - 2 = 0\\), \\[E = m c^{2}\\], \\(\\frac{1}{2}\\).
- Contoh SALAH (jangan ditiru): H2SO4, x^2, E = mc2, $x^2$.
- Di dalam JSON, backslash ditulis GANDA agar valid, mis. "rumus": "\\(x^{2}\\)".

CONTOH STRUKTUR (JANGAN salin isinya, gunakan sebagai panduan format dan kedalaman):
${FEWSHOT_MODUL_AJAR}
${fewshotNote(input.materi)}

Output JSON sesuai struktur yang ditentukan.`;

    let result = null, lastErr = null;
    for (let attempt = 1; attempt <= 2; attempt++) {
      try {
        result = await generateWithFallback(systemPrompt, userPrompt, 2, { maxTokens: 12000, checkCompleteness: checkCompletenessModulAjar });
        break;
      } catch (e) {
        lastErr = e;
        if (attempt < 2) showToast(`⚠️ Percobaan ${attempt} gagal, coba lagi...`, 'warning');
      }
    }
    if (!result) throw lastErr || new Error('Modul Ajar gagal digenerate');
    APP.phase2 = result;
    document.getElementById('phase2-status').className = 'phase-status success';
    document.getElementById('phase2-status').textContent = '✅ Selesai';
    renderPhase2(result);
document.getElementById('phase2-export').classList.remove('hidden');
    updateWizardStep(2, 'done');
    showToast('✅ Modul Ajar berhasil digenerate!', 'success');
  } catch (e) {
    document.getElementById('phase2-status').className = 'phase-status error';
    document.getElementById('phase2-status').textContent = '❌ Gagal';
    showToast(`❌ ${friendlyError(e.message)}`, 'error');
  } finally {
    btn.disabled = false;
    hideLoading();
  }
}

function renderPhase2(json) {
  const container = document.getElementById('phase2-preview');
  container.innerHTML = renderCodeCogs(buildModulAjarHTML(json));
}

function buildModulAjarHTML(json) {
  const ma = json.modulAjar || json;
  const ba = ma.bahanAjar || {};
  const input = APP.input;

  function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function list(items, tag='ol') {
    if (!Array.isArray(items) || !items.length) return '';
    return `<${tag}>${items.map(i => {
      if (typeof i === 'string') return `<li>${esc(i)}</li>`;
      if (i.konsep && i.definisi) return `<li><strong>${esc(i.konsep)}:</strong> ${esc(i.definisi)}${i.contoh ? ` <em>(contoh: ${esc(i.contoh)})</em>` : ''}</li>`;
      if (i.istilah && i.definisi) return `<li><strong>${esc(i.istilah)}:</strong> ${esc(i.definisi)}</li>`;
      if (i.pertanyaan && i.jawaban) return `<li><strong>Q: ${esc(i.pertanyaan)}</strong><br>A: ${esc(i.jawaban)}</li>`;
      if (i.nama) return `<li><strong>${esc(i.nama)}</strong>${i.detail ? ': ' + esc(i.detail) : ''}${i.rincian?.length ? '<ul>' + i.rincian.map(r => `<li>${esc(r)}</li>`).join('') + '</ul>' : ''}</li>`;
      if (i.sumber) return `<li>${esc(i.sumber)}${i.tautan ? ` (${esc(i.tautan)})` : ''}</li>`;
      return '';
    }).join('')}</${tag}>`;
  }

  let html = `<div class="rpp-document">`;
  html += `<div class="doc-title">MODUL AJAR</div>`;
  html += `<div class="doc-subtitle">${esc(input.mapel || '')} — ${esc(input.materi || '')}</div>`;
  html += `<table><tr><td><strong>Madrasah</strong></td><td>: ${esc(input.madrasah || '')}</td></tr>
    <tr><td><strong>Mata Pelajaran</strong></td><td>: ${esc(input.mapel || '')}</td></tr>
    <tr><td><strong>Materi</strong></td><td>: ${esc(input.materi || '')}</td></tr>
    <tr><td><strong>Elemen</strong></td><td>: ${esc(input.elemen || '')}</td></tr>
    <tr><td><strong>Fase/Kelas</strong></td><td>: ${esc(input.fase || '')}</td></tr>
    <tr><td><strong>Alokasi Waktu</strong></td><td>: ${esc(input.alkok || '')}</td></tr>
    <tr><td><strong>Penyusun</strong></td><td>: ${esc(input.guru || '')}</td></tr>
    <tr><td><strong>NUPTK</strong></td><td>: ${esc(input.nuptk || '-')}</td></tr></table>`;

  // Bahan Ajar
  html += `<div class="section-header">BAHAN AJAR</div>`;
  if (ba.pengertian) html += `<p style="text-align:justify;">${esc(ba.pengertian)}</p>`;
  if (ba.subBab?.length) {
    for (let bi = 0; bi < ba.subBab.length; bi++) {
      const sb = ba.subBab[bi];
      html += `<div class="sub-header">${bi + 1}. ${esc(sb.judul || '')}</div>`;
      if (sb.konten) html += `<p style="text-align:justify;">${esc(sb.konten)}</p>`;
      if (sb.contoh) html += `<p style="background:#e8f5e9;border-left:4px solid #43a047;padding:6px 10px;page-break-inside:avoid;"><strong>Contoh:</strong> ${esc(sb.contoh)}</p>`;
      if (sb.gambar) html += `<p><em>🖼️ Ilustrasi: ${esc(sb.gambar)}</em></p>`;
    }
  }

  // Ringkasan Materi
  if (ma.ringkasanMateri?.length) {
    html += `<div class="section-header">RINGKASAN MATERI</div>`;
    const h = ['Konsep', 'Definisi', 'Contoh'];
    const rows = ma.ringkasanMateri.map(r => {
      if (typeof r === 'string') return { 'Konsep': r, 'Definisi': '', 'Contoh': '' };
      return { 'Konsep': r.konsep || '', 'Definisi': r.definisi || '', 'Contoh': r.contoh || '' };
    });
    html += tableRender(h, rows);
  }

  // Mind Map
  if (ma.mindmap?.cabang?.length) {
    html += `<div class="section-header">PETA KONSEP (MIND MAP)</div>`;
    html += `<p style="text-align:center;font-weight:700;font-size:1.1rem;">${esc(ma.mindmap.topik || '')}</p>`;
    html += `<div style="display:flex;flex-wrap:wrap;gap:8px;margin:8px 0;">`;
    for (const c of ma.mindmap.cabang) {
      const nama = typeof c === 'string' ? c : (c.nama || '');
      const rincian = (typeof c === 'object' && c.rincian?.length) ? `<ul>${c.rincian.map(r => `<li>${esc(r)}</li>`).join('')}</ul>` : '';
      html += `<div style="flex:1 1 200px;border:1px solid #bdbdbd;border-radius:8px;overflow:hidden;page-break-inside:avoid;">`
        + `<div style="background:#e3f2fd;color:#1976d2;font-weight:700;padding:6px 10px;">🌿 ${esc(nama)}</div>`
        + (rincian ? `<div style="padding:6px 10px;">${rincian}</div>` : '')
        + `</div>`;
    }
    html += `</div>`;
  }

  // FAQ
  if (ma.faq?.length) {
    html += `<div class="section-header">FAQ (FREQUENTLY ASKED QUESTIONS)</div>`;
    ma.faq.forEach((f, idx) => {
      const q = typeof f === 'string' ? f : (f.pertanyaan || '');
      const a = typeof f === 'object' ? (f.jawaban || '') : '';
      html += `<div style="border:1px solid #bdbdbd;border-radius:8px;margin:8px 0;overflow:hidden;page-break-inside:avoid;">`
        + `<div style="background:#e3f2fd;padding:6px 10px;font-weight:700;">Q${idx + 1}: ${esc(q)}</div>`
        + (a ? `<div style="padding:6px 10px;">A: ${esc(a)}</div>` : '')
        + `</div>`;
    });
  }

  // Glosarium
  if (ma.glosarium?.length) {
    html += `<div class="section-header">GLOSARIUM</div>`;
    const h = ['Istilah', 'Definisi'];
    const rows = ma.glosarium.map(g => ({ 'Istilah': g.istilah || '', 'Definisi': g.definisi || '' }));
    html += tableRender(h, rows);
  }

  // Referensi
  if (ma.referensi?.length) {
    html += `<div class="section-header">REFERENSI & SUMBER BELAJAR</div>`;
    html += list(ma.referensi, 'ol');
  }

  // Refleksi Guru
  if (ma.refleksiGuru) {
    html += `<div class="section-header">LEMBAR REFLEKSI GURU</div>`;
    if (ma.refleksiGuru.pertanyaanRefleksi?.length) {
      html += `<div class="sub-header">Pertanyaan Refleksi</div>`;
      html += list(ma.refleksiGuru.pertanyaanRefleksi, 'ol');
    }
    if (ma.refleksiGuru.hal_yang_berhasil || ma.refleksiGuru.hal_yang_perlu_diperbaiki) {
      html += `<table>
        <tr><td style="width:250px"><strong>Hal yang Berhasil</strong></td><td>${esc(ma.refleksiGuru.hal_yang_berhasil || '')}</td></tr>
        <tr><td><strong>Hal yang Perlu Diperbaiki</strong></td><td>${esc(ma.refleksiGuru.hal_yang_perlu_diperbaiki || '')}</td></tr>
      </table>`;
    }
  }

  html += `</div>`;
  return html;
}

// ============================================================
// PHASE 3: MEDIA PEMBELAJARAN
// ============================================================
async function startPhase3() {
  if (!APP.phase1) { showToast('Generate RPP (Phase 1) dulu!', 'warning'); return; }
  const btn = document.getElementById('phase3-gen-btn');
  btn.disabled = true;
  if (!enterBusy('phase3')) { btn.disabled = false; return; }
  try {
    const desain = APP.phase1.rpp?.desainPembelajaran || APP.phase1.desainPembelajaran || {};
    const ident = APP.phase1.rpp?.identifikasi || APP.phase1.identifikasi || {};
    const input = APP.input;

    const systemPrompt = `Kamu adalah AI pembuat Media Pembelajaran kreatif untuk Kurikulum Merdeka. Output HANYA JSON valid.

STRUKTUR JSON:
{
  "media": {
    "slidePresentasi": [{ "slide": 1, "judul": "", "isi": "", "visual": "", "catatanPembicara": "" }],
    "videoScript": { "durasi": "", "adegan": [{ "waktu": "", "visual": "", "narasi": "", "efek": "" }] },
    "infografis": { "judul": "", "elemen": [{ "label": "", "data": "", "warna": "" }] },
    "kuisInteraktif": [{ "nomor": 1, "pertanyaan": "", "opsi": [], "kunci": "", "feedbackBenar": "", "feedbackSalah": "" }],
    "poster": { "judul": "", "konten": "", "warnaDominan": "", "gambar": "" }
  }
}

ATURAN:
1. Bahasa Indonesia baku
2. Slide presentasi minimal 10 slide dengan catatan pembicara detail
3. Video script minimal 5 adegan
4. Infografis dengan 5-7 elemen data visual
5. Kuis interaktif minimal 5 soal dengan feedback
6. Poster edukatif A3 size`;

    const userPrompt = `Buat Media Pembelajaran untuk:
- Madrasah: ${input.madrasah}
- Mata Pelajaran: ${input.mapel}
- Materi: ${input.materi}
- Elemen: ${input.elemen}
- Kelas: ${input.fase}
- CP: ${desain.capaianPembelajaran || input.cp}

Gunakan pendekatan Deep Learning (Mindful, Meaningful, Joyful) dan visual yang menarik.
Ekspresi matematika pakai \\(...\\) (inline) atau \\[...\\] (display) LaTeX. Aksara Arab/Jawa tulis langsung.

Output JSON sesuai struktur yang ditentukan.`;

    let result = null, lastErr = null;
    for (let attempt = 1; attempt <= 2; attempt++) {
      try {
        result = await generateWithFallback(systemPrompt, userPrompt, 3, { maxTokens: 12000, checkCompleteness: checkCompletenessMedia });
        break;
      } catch (e) {
        lastErr = e;
        if (attempt < 2) showToast(`⚠️ Percobaan ${attempt} gagal, coba lagi...`, 'warning');
      }
    }
    if (!result) throw lastErr || new Error('Media Pembelajaran gagal digenerate');
    APP.phase3 = result;
    document.getElementById('phase3-status').className = 'phase-status success';
    document.getElementById('phase3-status').textContent = '✅ Selesai';
    renderPhase3(result);
document.getElementById('phase3-export').classList.remove('hidden');
    document.getElementById('combined-export-card').classList.remove('hidden');
    updateWizardStep(3, 'done');
    showToast('✅ Media Pembelajaran berhasil digenerate!', 'success');
  } catch (e) {
    document.getElementById('phase3-status').className = 'phase-status error';
    document.getElementById('phase3-status').textContent = '❌ Gagal';
    showToast(`❌ ${friendlyError(e.message)}`, 'error');
  } finally {
    btn.disabled = false;
    hideLoading();
  }
}

function renderPhase3(json) {
  const container = document.getElementById('phase3-preview');
  container.innerHTML = renderCodeCogs(buildMediaHTML(json));
}

function buildMediaHTML(json) {
  const media = json.media || json;
  const input = APP.input;

  function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function list(items, tag='ol') {
    if (!Array.isArray(items) || !items.length) return '';
    return `<${tag}>${items.map(i => {
      if (typeof i === 'string') return `<li>${esc(i)}</li>`;
      if (i.slide && i.judul) {
        let out = `<li><strong>Slide ${i.slide}: ${esc(i.judul)}</strong>`;
        if (i.isi) out += `<br>${esc(i.isi)}`;
        if (i.visual) out += `<br><em>Visual: ${esc(i.visual)}</em>`;
        if (i.catatanPembicara) out += `<br><span style="color:#666;">🗣 ${esc(i.catatanPembicara)}</span>`;
        return out + '</li>';
      }
      if (i.waktu && i.visual) {
        let out = `<li><strong>[${esc(i.waktu)}]</strong> ${esc(i.visual)}`;
        if (i.narasi) out += `<br>🎤 ${esc(i.narasi)}`;
        if (i.efek) out += `<br><em>Efek: ${esc(i.efek)}</em>`;
        return out + '</li>';
      }
      if (i.nomor && i.pertanyaan) {
        let out = `<li><strong>${i.nomor}. ${esc(i.pertanyaan)}</strong>`;
        if (i.opsi?.length) {
          const labels = ['A','B','C','D'];
          out += '<ul>';
          i.opsi.forEach((o, idx) => { const txt = o.replace(/^[A-Da-d][.\s)]+\s*/, ''); out += `<li>${labels[idx] || (idx+1)}. ${esc(txt)}</li>`; });
          out += '</ul>';
        }
        out += `<br><span style="color:#c62828;">Kunci: ${esc(i.kunci || '')}</span>`;
        if (i.feedbackBenar) out += `<br><span style="color:#2e7d32;">✅ ${esc(i.feedbackBenar)}</span>`;
        if (i.feedbackSalah) out += `<br><span style="color:#c62828;">❌ ${esc(i.feedbackSalah)}</span>`;
        return out + '</li>';
      }
      if (i.label && i.data) return `<li><strong>${esc(i.label)}:</strong> ${esc(i.data)}${i.warna ? ` (warna: ${i.warna})` : ''}</li>`;
      return '';
    }).join('')}</${tag}>`;
  }

  let html = `<div class="rpp-document">`;
  html += `<div class="doc-title">MEDIA PEMBELAJARAN</div>`;
  html += `<div class="doc-subtitle">${esc(input.mapel || '')} — ${esc(input.materi || '')}</div>`;

  // Slide Presentasi
  if (media.slidePresentasi?.length) {
    html += `<div class="section-header">📊 SLIDE PRESENTASI</div>`;
    html += list(media.slidePresentasi, 'ol');
  }

  // Video Script
  if (media.videoScript) {
    html += `<div class="section-header">🎬 VIDEO PEMBELAJARAN</div>`;
    if (media.videoScript.durasi) html += `<p><strong>Durasi:</strong> ${esc(media.videoScript.durasi)}</p>`;
    if (media.videoScript.adegan?.length) {
      const h = ['Waktu', 'Visual', 'Narasi', 'Efek'];
      const rows = media.videoScript.adegan.map(a => ({ 'Waktu': a.waktu || '', 'Visual': a.visual || '', 'Narasi': a.narasi || '', 'Efek': a.efek || '' }));
      html += tableRender(h, rows);
    }
  }

  // Infografis
  if (media.infografis) {
    html += `<div class="section-header">📈 INFOGRAFIS</div>`;
    html += `<p style="text-align:center;font-weight:700;font-size:1rem;">${esc(media.infografis.judul || '')}</p>`;
    if (media.infografis.elemen?.length) {
      const h = ['Elemen', 'Data', 'Warna'];
      const rows = media.infografis.elemen.map(e => ({ 'Elemen': e.label || '', 'Data': e.data || '', 'Warna': e.warna || '' }));
      html += tableRender(h, rows);
    }
  }

  // Kuis Interaktif
  if (media.kuisInteraktif?.length) {
    html += `<div class="section-header">🎯 KUIS INTERAKTIF</div>`;
    html += list(media.kuisInteraktif, 'ol');
  }

  // Poster
  if (media.poster) {
    html += `<div class="section-header">🖼️ POSTER EDUKATIF</div>`;
    html += `<table>
      <tr><td style="width:120px"><strong>Judul</strong></td><td>${esc(media.poster.judul || '')}</td></tr>
      <tr><td><strong>Konten</strong></td><td>${esc(media.poster.konten || '')}</td></tr>
      <tr><td><strong>Warna Dominan</strong></td><td>${esc(media.poster.warnaDominan || '')}</td></tr>
      <tr><td><strong>Gambar</strong></td><td>${esc(media.poster.gambar || '-')}</td></tr>
    </table>`;
  }

  html += `</div>`;
  return html;
}

// Shared table helper
function tableRender(headers, rows) {
  function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  if (!Array.isArray(rows) || !rows.length) return '';
  const h = headers.map(header => `<th>${esc(header)}</th>`).join('');
  const r = rows.map(row => {
    let cells;
    if (Array.isArray(row)) {
      cells = headers.map((_, idx) => `<td>${esc(row[idx] ?? '')}</td>`).join('');
    } else {
      cells = headers.map(header => `<td>${esc(row[header] || '')}</td>`).join('');
    }
    return `<tr>${cells}</tr>`;
  }).join('');
  return `<table><thead><tr>${h}</tr></thead><tbody>${r}</tbody></table>`;
}

// ============================================================
// EXPORT PLACEHOLDERS
// ============================================================
function exportPhase1PDF() {
  phaseExportPDF('phase1-preview', 'RPP');
}
async function exportPhase1DOCX() {
  showToast('📝 DOCX: Menyiapkan dokumen...', 'info');
  if (typeof docx === 'undefined') { showToast('❌ Library DOCX belum siap', 'error'); return; }
  try {
    const html = document.getElementById('phase1-preview').innerHTML;
    const blob = await htmlToDocx(html, 'RPP');
    saveAs(blob, 'RPP.docx');
    showToast('✅ DOCX berhasil diunduh!', 'success');
  } catch(e) { showToast(`❌ Gagal: ${e.message}`, 'error'); }
}
function exportPhase1HTML() {
  showToast('🌐 Menyiapkan HTML...', 'info');
  const html = document.getElementById('phase1-preview').innerHTML;
  const style = Array.from(document.styleSheets).map(s => {
    try { return Array.from(s.cssRules || []).map(r => r.cssText).join('\n'); } catch(e) { return ''; }
  }).join('\n');
  const standalone = `<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><title>RPP - ${APP.input.madrasah || ''}</title><style>${style}</style></head><body><div class="rpp-document">${html}</div></body></html>`;
  const blob = new Blob([standalone], { type: 'text/html' });
  saveAs(blob, 'RPP-portfolio.html');
  showToast('✅ HTML berhasil diunduh!', 'success');
}

function exportPhase2PDF() { phaseExportPDF('phase2-preview', 'Modul Ajar'); }
function exportPhase2DOCX() { phaseExportDOCX('phase2-preview', 'ModulAjar.docx'); }
function exportPhase2HTML() { phaseExportHTML('phase2-preview', 'ModulAjar-portfolio.html'); }
function exportPhase3PDF() { phaseExportPDF('phase3-preview', 'Media Pembelajaran'); }
function exportPhase3DOCX() { phaseExportDOCX('phase3-preview', 'MediaPembelajaran.docx'); }
function exportPhase3HTML() { phaseExportHTML('phase3-preview', 'MediaPembelajaran-portfolio.html'); }

function phaseExportPDF(previewId, label) {
  showToast(`🔄 Buka dialog Print → pilih "Save as PDF"`, 'info');
  const el = document.getElementById(previewId);
  if (!el) return;
  el.classList.add('print-area');
  window.print();
  const cleanup = () => { el.classList.remove('print-area'); };
  if (window.onafterprint !== undefined) {
    window.onafterprint = cleanup;
    setTimeout(cleanup, 5000);
  } else {
    setTimeout(cleanup, 3000);
  }
}
async function phaseExportDOCX(previewId, filename) {
  showToast('📝 DOCX: Menyiapkan dokumen...', 'info');
  if (typeof docx === 'undefined') { showToast('❌ Library DOCX belum siap', 'error'); return; }
  try {
    const html = document.getElementById(previewId).innerHTML;
    const blob = await htmlToDocx(html, filename.replace('.docx',''));
    saveAs(blob, filename);
    showToast('✅ DOCX berhasil diunduh!', 'success');
  } catch(e) { showToast(`❌ Gagal: ${e.message}`, 'error'); }
}
function phaseExportHTML(previewId, filename) {
  showToast('🌐 Menyiapkan HTML...', 'info');
  const html = document.getElementById(previewId).innerHTML;
  const style = document.querySelector('style')?.innerHTML || '';
  const standalone = `<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>${filename.replace('-portfolio.html','')}</title><style>${style}</style></head><body><div class="rpp-document">${html}</div></body></html>`;
  saveAs(new Blob([standalone], { type: 'text/html' }), filename);
  showToast('✅ HTML berhasil diunduh!', 'success');
}

function exportCombinedPDF() {
  showToast(`🔄 Buka dialog Print → pilih "Save as PDF"`, 'info');
  const temp = document.createElement('div');
  temp.className = 'print-area';
  temp.style.cssText = 'position:absolute;left:0;top:0;width:100%;z-index:9999;background:#fff;';
  const phases = ['phase1-preview', 'phase2-preview', 'phase3-preview'];
  phases.forEach(id => {
    const el = document.getElementById(id)?.querySelector('.rpp-document');
    if (el) {
      if (temp.children.length > 0) {
        const br = document.createElement('div');
        br.style.cssText = 'page-break-before:always;height:1px;';
        temp.appendChild(br);
      }
      temp.appendChild(el.cloneNode(true));
    }
  });
  document.body.appendChild(temp);
  window.print();
  const cleanup = () => { if (temp.parentNode) temp.parentNode.removeChild(temp); };
  if (window.onafterprint !== undefined) { window.onafterprint = cleanup; setTimeout(cleanup, 5000); }
  else { setTimeout(cleanup, 3000); }
}
async function exportCombinedDOCX() {
  showToast('📝 DOCX: Menyiapkan dokumen gabungan...', 'info');
  if (typeof docx === 'undefined') { showToast('❌ Library DOCX belum siap', 'error'); return; }
  try {
    const { Document, Packer, Paragraph, TextRun, PageBreak } = docx;
    const children = [];
    const phases = [
      { id: 'phase1-preview', label: 'RPP & LAMPIRAN' },
      { id: 'phase2-preview', label: 'MODUL AJAR' },
      { id: 'phase3-preview', label: 'MEDIA PEMBELAJARAN' }
    ];
    for (const phase of phases) {
      const el = document.getElementById(phase.id);
      if (!el || !el.querySelector('.rpp-document')) continue;
      children.push(new Paragraph({ children: [new TextRun({ text: phase.label, bold: true, size: 28, font: 'Times New Roman' })], spacing: { before: 400, after: 200 } }));
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = el.innerHTML;
      const texts = Array.from(tempDiv.querySelectorAll('.rpp-document *')).filter(n => n.textContent?.trim()).map(n => n.textContent.trim());
      for (const t of texts) {
        if (t.length > 3) children.push(new Paragraph({ children: [new TextRun({ text: t, size: 22, font: 'Times New Roman' })], spacing: { before: 40 } }));
      }
      children.push(new Paragraph({ children: [new PageBreak()] }));
    }
    const doc = new Document({ title: 'RPP-Complete', sections: [{ properties: { page: { margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }] });
    const blob = await Packer.toBlob(doc);
    saveAs(blob, 'RPP-Complete.docx');
    showToast('✅ Combined DOCX berhasil diunduh!', 'success');
  } catch(e) { showToast(`❌ Gagal: ${e.message}`, 'error'); }
}
function exportCombinedHTML() {
  showToast('🌐 Menyiapkan HTML gabungan...', 'info');
  const style = document.querySelector('style')?.innerHTML || '';
  let body = '';
  const phases = [
    { id: 'phase1-preview', label: 'RPP & LAMPIRAN' },
    { id: 'phase2-preview', label: 'MODUL AJAR' },
    { id: 'phase3-preview', label: 'MEDIA PEMBELAJARAN' }
  ];
  for (const phase of phases) {
    const el = document.getElementById(phase.id)?.querySelector('.rpp-document');
    if (el) body += `<div class="doc-title" style="page-break-before:always;padding-top:40px;">${phase.label}</div>${el.innerHTML}`;
  }
  if (!body) { showToast('❌ Belum ada data untuk diexport', 'error'); return; }
  const standalone = `<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>RPP Complete Portfolio</title><style>${style}</style></head><body><div class="rpp-document">${body}</div></body></html>`;
  saveAs(new Blob([standalone], { type: 'text/html' }), 'RPP-Complete-portfolio.html');
  showToast('✅ Combined HTML berhasil diunduh!', 'success');
}

// ============================================================
// UTILITIES
// ============================================================
function saveAs(blob, filename) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(a.href); }, 100);
}
async function htmlToDocx(html, title) {
  const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, TableOfContents, HeadingLevel, AlignmentType, BorderStyle, WidthType, convertInchesToTwip } = docx;
  const temp = document.createElement('div');
  temp.innerHTML = html;
  const children = [];

  function getTextContent(node) {
    if (node.nodeType === 3) return node.textContent;
    return Array.from(node.childNodes).map(getTextContent).join('');
  }

  function isBold(el) {
    const tag = el.tagName.toLowerCase();
    if (['strong','b','th'].includes(tag)) return true;
    const fw = (el.style?.fontWeight || '').toString();
    return fw === '700' || fw === 'bold' || ['section-header'].some(c => el.classList?.contains(c));
  }

  function parseChildren(parent) {
    const results = [];
    const convertTable = (tblEl) => {
      const rows = Array.from(tblEl.querySelectorAll('tr'));
      const tableRows = rows.map(tr => {
        const cells = Array.from(tr.querySelectorAll('td, th'));
        const isHeader = tr.querySelector('th') !== null;
        const tableCells = cells.map(cell => {
          const ct = getTextContent(cell).trim();
          return new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: ct, bold: isHeader || isBold(cell), size: 20 })] })] });
        });
        return new TableRow({ children: tableCells });
      });
      if (!tableRows.length) return null;
      return new Table({ rows: tableRows });
    };
    for (const node of parent.childNodes) {
      if (node.nodeType === 3) { const t = node.textContent.trim(); if (t) results.push(t); continue; }
      if (node.nodeType !== 1) continue;
      const tag = node.tagName.toLowerCase();
      const text = getTextContent(node).trim();
      if (!text) continue;
      const bold = isBold(node);
      const italic = tag === 'i' || tag === 'em';
      const fontSize = bold ? 22 : 20;

      if (tag === 'table') {
        const converted = convertTable(node);
        if (converted) results.push(converted);
        continue;
      }

      if (tag === 'ol' || tag === 'ul') {
        Array.from(node.children).forEach(li => {
          const lt = getTextContent(li).trim();
          if (lt) {
            const isHeader = li.closest ? !!Array.from(document.querySelectorAll('.section-header, .sub-header')).find(h => h.contains(li)) : false;
            results.push(new Paragraph({ children: [new TextRun({ text: lt, bold: isHeader, size: 20 })], spacing: { before: 40 } }));
          }
        });
        continue;
      }

      if (['div','p','li'].includes(tag) || node.classList?.contains('section-header') || node.classList?.contains('sub-header')) {
        const cls = node.classList || { contains: () => false };
        const isSoalNomor = cls.contains('soal-nomor');
        const isSoalOpsi = cls.contains('soal-opsi');
        const isKunci = cls.contains('kunci-jawaban');
        const nestedTables = Array.from(node.querySelectorAll('table'));
        const mkPara = (t) => {
          const run = { text: t, bold: bold || isSoalNomor || isKunci, italics: italic, size: fontSize * 2, font: 'Times New Roman' };
          if (isKunci) run.color = 'C62828';
          const para = { children: [new TextRun(run)], spacing: { before: isSoalNomor ? 120 : 60, after: 60 } };
          if (isSoalOpsi) para.indent = { left: 720 };
          return new Paragraph(para);
        };
        if (nestedTables.length) {
          // Div soal yang memuat tabel data: keluarkan teks non-tabel dulu,
          // lalu tiap tabel sebagai tabel DOCX asli (tidak digepeng jadi paragraf)
          const clone = node.cloneNode(true);
          clone.querySelectorAll('table').forEach(tbl => tbl.remove());
          const t = getTextContent(clone).trim();
          if (t) results.push(mkPara(t));
          nestedTables.forEach(tbl => { const converted = convertTable(tbl); if (converted) results.push(converted); });
          continue;
        }
        results.push(mkPara(text));
        continue;
      }
    }
    return results;
  }

  const parsed = parseChildren(temp);
  children.push(...parsed);

  const doc = new Document({
    title,
    styles: { default: { document: { run: { font: 'Times New Roman', size: 24 } } } },
    sections: [{ properties: { page: { margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 } } }, children }]
  });
  return Packer.toBlob(doc);
}

// ============================================================
// CODECOGS LATEX (render LaTeX as image via CodeCogs, safe for PDF/HTML/DOCX)
// ============================================================
function cleanLaTeX(s) {
  // Fix all control chars from JSON-parse corruption of LaTeX escapes
  return String(s)
    .replace(/\u0008/g, '\\b').replace(/\u0009/g, '\\t')
    .replace(/\u000C/g, '\\f').replace(/\u000D/g, '\\r')
    // Perbaiki perintah \n... yang rusak karena \n di-parse JSON sebagai newline
    // cth: "\neq" -> newline+"eq". Daftar: \nabla \neq \neg \newcommand \newline \notin \nmid \not \num \ni
    .replace(/\n\s*(nabla|neq|neg|newcommand|newline|notin|nmid|not|num|ni)\b/g, '\\n$1');
}
function decodeEntities(s) {
  return String(s).replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
}
function looksLikeMath(e) {
  // Hindari false-positive (cth: harga $5000$, teks biasa) — anggap rumus jika ada
  // backslash perintah LaTeX atau operator ^ _ =
  return /\\|[\^_=]/.test(e) && /[a-zA-Z0-9\\]/.test(e);
}
function renderCodeCogs(text) {
  text = cleanLaTeX(text);
  const toImg = (formula, display) => {
    // esc() sudah mengubah & menjadi &amp; sebelum sampai sini — kembalikan agar rumus utuh
    const f = decodeEntities(cleanLaTeX(formula.trim()));
    if (!f) return '';
    const dpi = display ? 150 : 120;
    // SELURUH payload di-encode (sebelumnya prefix \inline \dpi... dibiarkan mentah di URL -> sering gagal)
    const payload = `\\inline \\dpi{${dpi}}${display ? ' \\large' : ''} ${f}`;
    const src = 'https://latex.codecogs.com/svg.image?' + encodeURIComponent(payload);
    const alt = f.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const style = display ? 'max-width:100%;' : 'display:inline;vertical-align:middle;max-width:100%;';
    // onerror: jika CodeCogs down/diblokir, tampilkan teks rumus (mono) agar dokumen tetap terbaca
    const img = `<img src="${src}" alt="${alt}" style="${style}" loading="lazy" onerror="var s=document.createElement('span');s.style.cssText='font-family:monospace;font-size:0.85em;background:#f5f5f5;border:1px solid #ddd;border-radius:4px;padding:2px 6px;word-break:break-all;';s.textContent=this.alt||'rumus';this.replaceWith(s);">`;
    return display ? `<div style="text-align:center;margin:8px 0;overflow-x:auto;">${img}</div>` : img;
  };
  // \[...\] display math
  text = text.replace(/\\\[([\s\S]+?)\\\]/g, (_, e) => toImg(e, true));
  // $$...$$ display math
  text = text.replace(/\$\$([\s\S]+?)\$\$/g, (_, e) => toImg(e, true));
  // \(...\) inline math
  text = text.replace(/\\\(([\s\S]+?)\\\)/g, (_, e) => toImg(e, false));
  // $...$ inline math — hanya jika terlihat seperti rumus matematika
  text = text.replace(/(?<!\$)\$([^\n$]+?)\$(?!\$)/g, (_, e) => (looksLikeMath(e) ? toImg(e, false) : `$${e}$`));
  return text;
}

// ============================================================
// RESET
// ============================================================
function resetAll() {
  if (!confirm('Reset semua data? Data yang belum disimpan akan hilang.')) return;
  APP.phase1 = null;
  APP.phase2 = null;
  APP.phase3 = null;
  APP.input = {};
  document.getElementById('rpp-form').reset();
  document.getElementById('phase1-preview').innerHTML = '<div class="preview-empty"><div class="icon">📋</div><p>Generate RPP + Lampiran untuk melihat hasil di sini.</p></div>';
  document.getElementById('phase2-preview').innerHTML = '<div class="preview-empty"><div class="icon">📖</div><p>Generate Modul Ajar setelah RPP selesai.</p></div>';
  document.getElementById('phase3-preview').innerHTML = '<div class="preview-empty"><div class="icon">🎬</div><p>Generate Media Pembelajaran setelah Modul Ajar selesai.</p></div>';
  document.querySelectorAll('.phase-status').forEach(el => { el.className = 'phase-status pending'; el.textContent = '⏳ Belum digenerate'; });
  document.querySelectorAll('.export-bar').forEach(el => el.classList.add('hidden'));
  document.getElementById('combined-export-card').classList.add('hidden');
  document.querySelectorAll('.wizard-step').forEach(el => { el.classList.remove('done', 'active'); });
  document.querySelector('.wizard-step').classList.add('active');
  document.querySelectorAll('[id^="step-"]').forEach(el => el.classList.add('hidden'));
  document.getElementById('step-0').classList.remove('hidden');
  document.getElementById('phase1-back').classList.add('hidden');
  // Reset progress bar
  document.getElementById('phase1-progress').classList.add('hidden');
  document.getElementById('phase1-progress-fill').style.width = '0%';
  document.getElementById('phase1-progress-steps').innerHTML = '';
  APP.currentStep = 0;
  showToast('↺ Reset berhasil', 'info');
}

// ============================================================
// INIT
// ============================================================
loadSettings();
showStep(0);
</script>
